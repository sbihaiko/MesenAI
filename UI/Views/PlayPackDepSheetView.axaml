<UserControl xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:l="using:Mesen.Localization"
	xmlns:vm="using:Mesen.ViewModels"
	mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="640"
	x:Class="Mesen.Views.PlayPackDepSheetView"
	x:DataType="vm:PlayPackDepSheetViewModel"
>
	<!--G.5 (PRD Part B §13.5.2 W-P16): a pack waits for a file only you can
	add, opened over the pause overlay. Rule 2: drop zone, Show Folder, Play
	Without It, Choose File… (Add and Restart… until P.9) = 4.-->
	<!--ADR-0249 (W-P16): the light sheet - share-green pack badge, title and
	subtitle, body, the file box, the drop zone, the orange wrong-file line,
	then Show Folder (plain, left), Play Without It and Choose File….-->
	<Panel Name="PackDepSheetBackdrop" Classes="scrim" DragDrop.AllowDrop="True">
		<Border Name="PackDepSheet" Classes="sheet" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center">
			<StackPanel Spacing="0" XYFocus.NavigationModes="Enabled">
				<DockPanel Margin="0 0 0 16">
					<Border Classes="badge xlarge share" DockPanel.Dock="Left" Margin="0 0 12 0" VerticalAlignment="Top">
						<PathIcon Data="{StaticResource PlayerIconPack}" />
					</Border>
					<StackPanel VerticalAlignment="Center" Spacing="2">
						<TextBlock Name="PackDepSheetTitle" Classes="sheet-heading" Text="{Binding Title}" TextWrapping="Wrap" />
						<TextBlock Classes="subhead secondary" Text="{l:Translate lblPackDepSheetSubtitle}" TextWrapping="Wrap" />
					</StackPanel>
				</DockPanel>
				<TextBlock Classes="paragraph" Text="{l:Translate lblPackDepSheetBody}" TextWrapping="Wrap" Margin="0 0 0 14" />
				<Border Classes="inset file-box" Margin="0 0 0 10">
					<StackPanel Spacing="2">
						<TextBlock Name="PackDepSheetFile" Classes="callout strong" Text="{Binding FileTitle}" TextWrapping="Wrap" />
						<TextBlock Name="PackDepSheetLicense" Classes="subhead secondary" Text="{Binding LicenseText}" />
					</StackPanel>
				</Border>
				<Button Name="PackDepSheetDropZone" Classes="drop-zone" Click="OnChooseFile" IsEnabled="{Binding !IsBusy}">
					<StackPanel Spacing="4" HorizontalAlignment="Center">
						<PathIcon Classes="drop-icon" Margin="0 0 0 6" />
						<TextBlock Classes="drop-title" Text="{l:Translate lblPackDepSheetDrop}" />
						<TextBlock Classes="drop-hint" Text="{Binding DropHint}" TextWrapping="Wrap" />
					</StackPanel>
				</Button>
				<!--Every wait moves (2026-10-03): the dropped file is hashed and
				copied off the UI thread; the controls gray out and this moves.-->
				<StackPanel Name="PackDepSheetBusy" Spacing="8" Margin="0 12 0 0" IsVisible="{Binding IsBusy}">
					<TextBlock Name="PackDepSheetBusyText" Classes="subhead secondary" Text="{l:Translate lblPackDepSheetBusy}" />
					<ProgressBar IsIndeterminate="True" Width="220" HorizontalAlignment="Left" />
				</StackPanel>
				<!--W-X2: "That is not the file this pack was made with" - the shared
				in-place banner, as the BIOS sheet's.-->
				<Border Name="PackDepSheetError" Classes="banner warning" Margin="0 12 0 0" IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
					<DockPanel>
						<PathIcon Classes="banner-icon" DockPanel.Dock="Left" Data="{StaticResource PlayerIconWarning}" Width="16" Height="16" />
						<TextBlock Classes="banner-text" Text="{Binding ErrorText}" TextWrapping="Wrap" VerticalAlignment="Center" />
					</DockPanel>
				</Border>
				<DockPanel Margin="0 22 0 0">
					<Button Name="PackDepSheetShowFolder" Classes="plain regular" DockPanel.Dock="Left" Click="OnShowFolder">
						<StackPanel Orientation="Horizontal">
							<PathIcon Classes="leading" Data="{StaticResource PlayerIconFolder}" />
							<TextBlock Text="{l:Translate btnPackDepSheetShowFolder}" />
						</StackPanel>
					</Button>
					<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
						<Button Name="PackDepSheetPlayWithout" Classes="secondary regular" Content="{l:Translate btnPackDepSheetPlayWithout}" Click="OnPlayWithout" />
						<Button Name="PackDepSheetChooseFile" Classes="primary regular" Content="{Binding PrimaryLabel}" Click="OnChooseFile" IsEnabled="{Binding !IsBusy}" />
					</StackPanel>
				</DockPanel>
			</StackPanel>
		</Border>
	</Panel>
</UserControl>
