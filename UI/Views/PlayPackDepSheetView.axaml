<UserControl xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:l="using:Mesen.Localization"
	xmlns:vm="using:Mesen.ViewModels"
	mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="640"
	x:Class="Mesen.Views.PlayPackDepSheetView"
	x:DataType="vm:PlayPackDepSheetViewModel"
>
	<!--G.5 (PRD Part B §13.5.2 W-P16): a pack waits for a file only you can
	add, opened over the pause overlay. Rule 2: drop zone, Show Folder, Play
	Without It, Choose File… (Add and Restart… until P.9) = 4.-->
	<Panel Name="PackDepSheetBackdrop" Background="#80000000" DragDrop.AllowDrop="True">
		<Border Name="PackDepSheet" Background="White" CornerRadius="14" Padding="28 24" MaxWidth="580" HorizontalAlignment="Center" VerticalAlignment="Center">
			<StackPanel Spacing="12" XYFocus.NavigationModes="Enabled">
				<StackPanel Orientation="Horizontal" Spacing="12">
					<Border Width="40" Height="40" CornerRadius="8" Background="#34C759">
						<TextBlock Text="▣" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Border>
					<StackPanel VerticalAlignment="Center">
						<TextBlock Name="PackDepSheetTitle" Text="{Binding Title}" FontSize="19" FontWeight="Bold" Foreground="#1C1C1E" TextWrapping="Wrap" />
						<TextBlock Text="{l:Translate lblPackDepSheetSubtitle}" Foreground="#6E6E73" />
					</StackPanel>
				</StackPanel>
				<TextBlock Text="{l:Translate lblPackDepSheetBody}" TextWrapping="Wrap" Foreground="#1C1C1E" />
				<Border Background="#F5F5F7" CornerRadius="10" Padding="14 10">
					<StackPanel Spacing="2">
						<TextBlock Name="PackDepSheetFile" Text="{Binding FileTitle}" FontWeight="Bold" Foreground="#1C1C1E" TextWrapping="Wrap" />
						<TextBlock Name="PackDepSheetLicense" Text="{Binding LicenseText}" Foreground="#6E6E73" />
					</StackPanel>
				</Border>
				<Button Name="PackDepSheetDropZone" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="16 18" Background="#F5F5F7" BorderBrush="#C7C7CC" BorderThickness="1" CornerRadius="10" Click="OnChooseFile" IsEnabled="{Binding !IsBusy}">
					<StackPanel Spacing="4" HorizontalAlignment="Center">
						<TextBlock Text="📁" HorizontalAlignment="Center" />
						<TextBlock Text="{l:Translate lblPackDepSheetDrop}" FontWeight="Bold" Foreground="#1C1C1E" HorizontalAlignment="Center" />
						<TextBlock Text="{Binding DropHint}" Foreground="#6E6E73" HorizontalAlignment="Center" TextWrapping="Wrap" />
					</StackPanel>
				</Button>
				<!--W-X2: "That is not the file this pack was made with".-->
				<Border Name="PackDepSheetError" Background="#FFF4E5" CornerRadius="8" Padding="12 8" IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
					<TextBlock Text="{Binding ErrorText}" Foreground="#B25000" TextWrapping="Wrap" />
				</Border>
				<DockPanel Margin="0 8 0 0">
					<Button Name="PackDepSheetShowFolder" DockPanel.Dock="Left" Content="{l:Translate btnPackDepSheetShowFolder}" Background="Transparent" Foreground="#0A84FF" Click="OnShowFolder" />
					<StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
						<Button Name="PackDepSheetPlayWithout" Content="{l:Translate btnPackDepSheetPlayWithout}" Padding="16 6" Click="OnPlayWithout" />
						<Button Name="PackDepSheetChooseFile" Content="{Binding PrimaryLabel}" Padding="16 6" FontWeight="Bold" Background="#0A84FF" Foreground="White" Click="OnChooseFile" IsEnabled="{Binding !IsBusy}" />
					</StackPanel>
				</DockPanel>
			</StackPanel>
		</Border>
	</Panel>
</UserControl>
