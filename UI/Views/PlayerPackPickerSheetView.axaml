<UserControl xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:l="using:Mesen.Localization"
	xmlns:vm="using:Mesen.ViewModels"
	mc:Ignorable="d"
	x:Class="Mesen.Views.PlayerPackPickerSheetView"
	x:DataType="vm:MainWindowViewModel"
>
	<!--G.4 (PRD Part B §13.5.2 W-P5; P.5 §5): the pack picker. Opens once over
	the un-enhanced game when 2+ competing pack_ids exist and no stored choice
	applies, and from W-P4's Pack row to change the choice. One radio per pack
	(the stored choice, else the 👍-first row, starts selected); Use This Pack
	stores the per-ROM preference (P.3) and applies it; Cancel/Esc plays
	un-enhanced and asks again next launch. The last row is "No pack"
	(PlayerPackChoice.NoPackRow): it stores PackPreferenceResolver.NoPack,
	which the core honours (MepPackManager::PreferenceAllowsPack).-->
	<!--ADR-0249 (W-P5): a light sheet - option cards (RadioButton.option),
	the 👍 count at the card's top right, Cancel and Use This Pack.-->
	<Border
		Name="PlayerPackPicker"
		Classes="sheet"
		Width="500"
		HorizontalAlignment="Center"
		VerticalAlignment="Center"
		IsVisible="{Binding IsPlayerPackPickerVisible}"
	>
		<StackPanel Spacing="0" XYFocus.NavigationModes="Enabled">
			<TextBlock Name="PackPickerTitle" Classes="title3" Text="{Binding PackPickerTitle}" TextWrapping="Wrap" Margin="0 4 0 18" />
			<ItemsControl Name="PackPickerList" ItemsSource="{Binding PlayerPackChoices}" XYFocus.NavigationModes="Enabled">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Spacing="8" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="vm:PlayerPackChoice">
						<RadioButton Classes="option" GroupName="PlayerPackPickerChoices" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
							IsChecked="{Binding IsSelected, Mode=TwoWay}" Tag="{Binding Container}" Click="OnSelectChoice">
							<!--The name is the row's first text (tests and screen readers read it
							first); the votes sit in the right column.-->
							<Grid ColumnDefinitions="*,Auto">
								<StackPanel Grid.Column="0" Spacing="3">
									<TextBlock Classes="option-title" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
									<TextBlock Classes="subhead secondary" TextWrapping="Wrap" Text="{Binding Detail}" />
									<!-- ADR-0152: a reviewed known-missing declaration is shown on the
									     row it belongs to, naming MesenCE validation as its source so the
									     gap is never read as the author's claim. The ADR's wording is kept
									     over the wireframe's shorter one. Collapsed when absent. -->
									<DockPanel IsVisible="{Binding HasKnownMissing}" Margin="0 2 0 0">
										<PathIcon Classes="warning" Width="12" Height="12" VerticalAlignment="Top" Margin="0 1 6 0" />
										<TextBlock Classes="warning badge-text" TextWrapping="Wrap" Text="{Binding KnownMissingNote}" />
									</DockPanel>
								</StackPanel>
								<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Margin="12 1 0 0" IsVisible="{Binding HasVotes}">
									<PathIcon Classes="votes" />
									<TextBlock Classes="callout secondary" Text="{Binding Votes}" />
								</StackPanel>
							</Grid>
						</RadioButton>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
			<TextBlock Classes="subhead secondary" Text="{l:Translate lblPackPickerRemembered}" TextWrapping="Wrap" Margin="2 14 0 24" />
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
				<Button Name="PackPickerCancelButton" Classes="secondary regular" Content="{l:Translate btnPackPickerCancel}" Click="OnCancel" />
				<Button Name="PackPickerUseButton" Classes="primary regular" Content="{l:Translate btnPackPickerUse}" IsEnabled="{Binding CanUseSelectedPack}" Click="OnUse" />
			</StackPanel>
		</StackPanel>
	</Border>
</UserControl>
