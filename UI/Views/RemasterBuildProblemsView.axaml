<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:Mesen.ViewModels"
	xmlns:l="using:Mesen.Localization"
	mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="200"
	x:DataType="vm:RemasterWorkspaceViewModel"
	x:Class="Mesen.Views.RemasterBuildProblemsView"
>
	<!--G.6 (PRD Part B §13.5.3 W-R4): build problems, inline, in place of the
	job card. Each problem is a sentence about the surface the artist painted,
	with the file to open (a row action); a line without a translation is only
	counted, and the raw log is behind Show Log (rule 3). Show Log and Try Again
	are the two controls.-->
	<!--ADR-0249 (W-R4): the title as a card's first line, each problem a
	subhead sentence with a small secondary Open File, the plain Show Log and
	the small primary Try Again.-->
	<!--The render's hierarchy (Player only): a drawn orange warning before the
	title; each problem's name in bold, then its sentence in the secondary
	color. Advanced keeps the "⚠ …" title and the caption-led "· …" rows.-->
	<UserControl.Styles>
		<Style Selector="DockPanel#RemasterBuildProblemsTitleRow, DockPanel.problem-split">
			<Setter Property="IsVisible" Value="False" />
		</Style>
		<Style Selector=".player DockPanel#RemasterBuildProblemsTitleRow, .player DockPanel.problem-split">
			<Setter Property="IsVisible" Value="True" />
		</Style>
		<Style Selector=".player TextBlock#RemasterBuildProblemsClassicTitle, .player TextBlock.problem-line">
			<Setter Property="IsVisible" Value="False" />
		</Style>
		<Style Selector="PathIcon#RemasterBuildProblemsIcon">
			<Setter Property="Width" Value="14" />
			<Setter Property="Height" Value="14" />
			<Setter Property="Margin" Value="0 0 8 0" />
		</Style>
		<Style Selector=".player PathIcon#RemasterBuildProblemsIcon">
			<Setter Property="Width" Value="18" />
			<Setter Property="Height" Value="18" />
			<Setter Property="Margin" Value="0 0 10 0" />
		</Style>
		<Style Selector="TextBlock.problem-name">
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Margin" Value="0 0 10 0" />
		</Style>
		<Style Selector=".player TextBlock.problem-name">
			<Setter Property="FontSize" Value="{StaticResource PlayerFontBody}" />
		</Style>
		<Style Selector=".player TextBlock.problem-text">
			<Setter Property="FontSize" Value="{StaticResource PlayerFontSubhead}" />
		</Style>
		<Style Selector=".player StackPanel#RemasterBuildProblems">
			<Setter Property="Spacing" Value="8" />
		</Style>
	</UserControl.Styles>
	<StackPanel Name="RemasterBuildProblems" Spacing="10">
		<TextBlock Name="RemasterBuildProblemsClassicTitle" Classes="emphasis" Text="{Binding BuildProblemsClassicTitle}" />
		<DockPanel Name="RemasterBuildProblemsTitleRow">
			<PathIcon Name="RemasterBuildProblemsIcon" Classes="warning" DockPanel.Dock="Left" VerticalAlignment="Center" Data="{StaticResource PlayerIconWarning}" />
			<TextBlock Name="RemasterBuildProblemsTitle" Classes="emphasis" Text="{Binding BuildProblemsTitle}" VerticalAlignment="Center" />
		</DockPanel>
		<ItemsControl Name="RemasterBuildProblemList" ItemsSource="{Binding BuildProblems}">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<StackPanel Spacing="8" />
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="vm:RemasterProblemRow">
					<DockPanel Margin="28 0 0 0">
						<Button DockPanel.Dock="Right" Classes="secondary small" Margin="16 0 0 0" VerticalAlignment="Center" Content="{l:Translate btnOpenProblemFile}" IsVisible="{Binding CanOpen}" Click="OnOpenFile" />
						<Panel>
							<TextBlock Classes="problem-line body" Text="{Binding ClassicText, StringFormat='· {0}'}" TextWrapping="Wrap" VerticalAlignment="Center" />
							<DockPanel Classes="problem-split">
								<TextBlock DockPanel.Dock="Left" Classes="problem-name body" Text="{Binding Name}" TextWrapping="NoWrap" VerticalAlignment="Center" IsVisible="{Binding Name, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
								<TextBlock Classes="problem-text subhead secondary" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
							</DockPanel>
						</Panel>
					</DockPanel>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
		<TextBlock Name="RemasterBuildProblemsNote" Classes="subhead secondary" Margin="28 0 0 0" Text="{Binding BuildProblemsNote}" IsVisible="{Binding BuildProblemsNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
		<StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
			<Button Name="RemasterShowBuildLogButton" Classes="plain small" Content="{l:Translate btnShowBuildLog}" Click="OnShowLog" />
			<Button Name="RemasterTryBuildAgainButton" Classes="primary small" Content="{l:Translate btnTryBuildAgain}" IsEnabled="{Binding BuildAndShow.IsEnabled}" Click="OnTryAgain" />
		</StackPanel>
		<TextBlock Name="RemasterTryBuildAgainReason" Classes="reason secondary" HorizontalAlignment="Right" Text="{Binding BuildAndShow.Reason}" IsVisible="{Binding BuildAndShow.HasReason}" />
		<!--Height NaN: the theme's TextBox is a 30 px field; the log grows.-->
		<TextBox Name="RemasterBuildLog" Text="{Binding BuildLogText}" IsReadOnly="True" TextWrapping="NoWrap" Height="NaN" MaxHeight="240" VerticalContentAlignment="Top" FontFamily="{DynamicResource MesenMonospaceFont}" IsVisible="{Binding IsBuildLogVisible}" />
	</StackPanel>
</UserControl>
