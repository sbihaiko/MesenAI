<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:Mesen.ViewModels"
	xmlns:v="using:Mesen.Views"
	xmlns:l="using:Mesen.Localization"
	mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="44"
	x:DataType="vm:ShareWorkspaceViewModel"
	x:Class="Mesen.Views.ShareRecordingStrip"
>
	<!--G.8 (PRD Part B §13.5.4 W-H4): a replay is recording. The game fills the
	rest of the window inside Share (as W-R2); this strip is the one pill, plus
	the same Stop as W-R2 for a mouse. It sits above the game, not over it,
	because the native renderer draws above Avalonia content.-->
	<!--ADR-0249: in Player mode the strip is W-R2's HUD (Border.hud, red dot,
	white semibold pill, grey `primary hud` Stop); Advanced keeps the classic one.-->
	<UserControl.Styles>
		<Style Selector="v|ShareRecordingStrip:not(.player) Border#ShareRecordingStripBorder">
			<Setter Property="Background" Value="#202020" />
			<Setter Property="Padding" Value="12 6" />
		</Style>
		<Style Selector="v|ShareRecordingStrip:not(.player) TextBlock#ShareRecordingPill">
			<Setter Property="Foreground" Value="White" />
			<Setter Property="FontWeight" Value="Bold" />
		</Style>
		<Style Selector="v|ShareRecordingStrip:not(.player) StackPanel#ShareReplayStopWait TextBlock">
			<Setter Property="Foreground" Value="White" />
		</Style>
		<Style Selector="v|ShareRecordingStrip:not(.player) Ellipse#ShareRecordingDot">
			<Setter Property="Fill" Value="#FF3B30" />
		</Style>
		<Style Selector="v|ShareRecordingStrip:not(.player) PathIcon">
			<Setter Property="IsVisible" Value="False" />
		</Style>
		<Style Selector="v|ShareRecordingStrip.player Border#ShareRecordingStripBorder">
			<Setter Property="Padding" Value="16 10" />
		</Style>
		<Style Selector="v|ShareRecordingStrip.player Ellipse#ShareRecordingDot">
			<Setter Property="Fill" Value="{StaticResource PlayerRedBrush}" />
		</Style>
		<Style Selector="v|ShareRecordingStrip.player TextBlock#ShareRecordingPill">
			<Setter Property="FontSize" Value="{StaticResource PlayerFontHeadline}" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{StaticResource PlayerCardBrush}" />
		</Style>
	</UserControl.Styles>
	<Border Name="ShareRecordingStripBorder" Classes="hud">
		<DockPanel>
			<Button Name="ShareStopRecordingButton" DockPanel.Dock="Right" Classes="primary hud" IsEnabled="{Binding !IsReplayStopping}" Click="OnStop">
				<StackPanel Orientation="Horizontal"><PathIcon Classes="leading" Data="{StaticResource PlayerIconStop}" /><TextBlock Text="{l:Translate btnStopReplay}" /></StackPanel>
			</Button>
			<!--The core writes the .mmo off the UI thread: a moving wait until it answers.-->
			<StackPanel Name="ShareReplayStopWait" DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" Margin="0 0 14 0" VerticalAlignment="Center" IsVisible="{Binding IsReplayStopping}">
				<TextBlock Text="{Binding ReplayWaitText}" VerticalAlignment="Center" />
				<ProgressBar IsIndeterminate="True" Width="120" VerticalAlignment="Center" />
			</StackPanel>
			<StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
				<Ellipse Name="ShareRecordingDot" Width="10" Height="10" VerticalAlignment="Center" />
				<TextBlock Name="ShareRecordingPill" Text="{Binding RecordingPill}" VerticalAlignment="Center" />
			</StackPanel>
		</DockPanel>
	</Border>
</UserControl>
