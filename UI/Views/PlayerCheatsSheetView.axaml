<UserControl xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:l="using:Mesen.Localization"
	xmlns:vm="using:Mesen.ViewModels"
	xmlns:lg="using:Mesen.Logic"
	mc:Ignorable="d"
	x:Class="Mesen.Views.PlayerCheatsSheetView"
	x:DataType="vm:PlayerCheatsSheetViewModel"
>
	<!--P.10 (ADR-0245 §1-§3, §5; PRD Part B §13 W-P11): the Play Cheats sheet,
	opened from the pause overlay's Cheats row. Interactive elements at rest:
	search, Add a Code…, Done (+ list rows). The toggles write the same
	CheatCodes list the classic cheat window edits. Every rule (rows, search,
	not-in-list fallback, recording-art refusal, console scope) is in the
	host-free UI/Logic/CheatSheet; this view only binds it.-->
	<!--ADR-0249 (W-P11): a light sheet - the search field, the cheats as
	CheckBox.switch rows in an inset list (the note under the name), the
	status and replay lines, Add a Code… on the left and Done on the right.-->
	<Border
		Name="PlayerCheatsSheet"
		Classes="sheet"
		Width="500"
		HorizontalAlignment="Center"
		VerticalAlignment="Center"
		IsVisible="{Binding IsVisible}"
	>
		<StackPanel Spacing="0">
			<TextBlock Classes="title3" Text="{l:Translate lblCheatsTitle}" Margin="0 4 0 12" />
			<TextBox Name="CheatsSearchBox" Text="{Binding SearchText}" PlaceholderText="{Binding SearchPlaceholder}" IsEnabled="{Binding IsSearchEnabled}" Margin="0 0 0 12" />

			<!--P.11 (ADR-0245 §4, #922): search by intent. The answer is one of the
			listed entries (highlighted below) or a line saying none matched; the
			OpenRouter key lives in the OS credential store and is removable here.-->
			<StackPanel Name="CheatsIntentPanel" Spacing="8" Margin="0 0 0 12" IsVisible="{Binding IsIntentAvailable}">
				<DockPanel>
					<Button Name="CheatsIntentFind" Classes="secondary regular" DockPanel.Dock="Right" Margin="8 0 0 0" Content="{Binding FindLabel}" IsEnabled="{Binding !IsIntentSearching}" Click="OnFindIntent" />
					<TextBox Name="CheatsIntentBox" Text="{Binding IntentText}" PlaceholderText="{Binding IntentPlaceholder}" MaxLength="200" KeyDown="OnIntentKeyDown" />
				</DockPanel>
				<!--Every wait moves (2026-10-03).-->
				<ProgressBar Name="CheatsIntentBar" IsIndeterminate="True" Width="200" HorizontalAlignment="Left" IsVisible="{Binding IsIntentSearching}" />
				<TextBlock Name="CheatsIntentLine" Classes="subhead secondary" TextWrapping="Wrap" Text="{Binding IntentLine}" IsVisible="{Binding IntentLine.Length}" />
				<DockPanel>
					<Button Name="CheatsKeyRemove" Classes="plain small" DockPanel.Dock="Right" Content="{Binding RemoveKeyLabel}" Click="OnRemoveKey" />
					<Button Name="CheatsKeySave" Classes="plain small" DockPanel.Dock="Right" Content="{Binding SaveKeyLabel}" Click="OnSaveKey" />
					<TextBox Name="CheatsKeyBox" Text="{Binding KeyText}" PasswordChar="•" PlaceholderText="{Binding KeyPlaceholder}" />
				</DockPanel>
				<TextBlock Classes="footnote secondary" TextWrapping="Wrap" Text="{Binding KeyLine}" IsVisible="{Binding KeyLine.Length}" />
			</StackPanel>

			<!--Not in the list: games by name; picking one borrows its codes.-->
			<ItemsControl Name="CheatsGameResults" ItemsSource="{Binding GameResults}" IsVisible="{Binding IsGameSearch}" Margin="0 0 0 12">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Spacing="6" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="lg:CheatDbGame">
						<Button Classes="secondary regular" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding Name}" Click="OnPickGame" />
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<!--The inset is drawn behind the list, not around it: CheatsList stays
			in the visual tree when there are no rows (only the chrome hides).-->
			<Panel>
				<Border Classes="inset" IsVisible="{Binding Rows.Count}" />
				<ScrollViewer MaxHeight="320" Margin="1" HorizontalScrollBarVisibility="Disabled">
					<ItemsControl Name="CheatsList" ItemsSource="{Binding Rows}" XYFocus.NavigationModes="Enabled">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="vm:PlayerCheatRow">
								<Border Classes="switch-row tall">
									<StackPanel>
										<Panel>
											<CheckBox Classes="switch" Classes.subtitled="{Binding HasNote}" Content="{Binding Description}" IsChecked="{Binding IsOn, Mode=OneWay}" IsEnabled="{Binding CanToggle}" Click="OnToggleCheat" />
											<TextBlock Classes="row-subtitle" TextTrimming="CharacterEllipsis" Text="{Binding Note}" IsVisible="{Binding HasNote}" />
										</Panel>
										<!--P.11: the entry the search by intent picked.-->
										<TextBlock Name="CheatsIntentMatchMark" Classes="footnote" Margin="0 -6 0 8" Text="{Binding IntentMatchMark}" IsVisible="{Binding IsIntentMatch}" />
										<!--R.4 (ADR-0248 §5): a community row, "from the community · 👍 N";
										the count opens the submission issue to vote there (↗).-->
										<StackPanel Name="CheatsCommunityMark" Orientation="Horizontal" Spacing="6" Margin="0 -6 0 8" IsVisible="{Binding IsCommunity}">
											<TextBlock Classes="footnote secondary" VerticalAlignment="Center" Text="{Binding CommunityMark}" />
											<Button Name="CheatsVotesButton" Classes="plain small" Content="{Binding VotesLabel}" Click="OnOpenIssue" />
										</StackPanel>
										<!--ADR-0248 §2: the user's own codes only; bundled and community codes are already shared.-->
										<Button Name="CheatsShareButton" Classes="plain small" HorizontalAlignment="Left" Margin="-11 -6 0 8" Content="{l:Translate btnCheatsShare}" IsVisible="{Binding CanShare}" Click="OnShareCheat" />
									</StackPanel>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</Panel>

			<TextBlock Name="CheatsStatusLine" Classes="subhead secondary" Text="{Binding StatusLine}" TextWrapping="Wrap" Margin="2 16 0 0" />
			<!--Every wait moves (2026-10-03): the community catalog is still being fetched.-->
			<ProgressBar Name="CheatsLoadingBar" IsIndeterminate="True" Width="200" HorizontalAlignment="Left" Margin="2 8 0 0" IsVisible="{Binding IsCommunityLoading}" />
			<Button Name="CheatsChangeGameButton" Classes="secondary regular" HorizontalAlignment="Left" Margin="0 8 0 0" Content="{l:Translate btnCheatsChangeGame}" IsVisible="{Binding IsBorrowingGame}" Click="OnChangeGame" />
			<TextBlock Classes="footnote secondary" TextWrapping="Wrap" Margin="2 6 0 0" Text="{Binding AllOffNote}" IsVisible="{Binding IsAllOff}" />
			<TextBlock Classes="replay-note" TextWrapping="Wrap" Margin="2 8 0 0" Text="{Binding ReplayNote}" />

			<!--*Add a Code…*: a code typed by hand; the full editor stays in Classic › Tools › Cheats.-->
			<StackPanel Name="CheatsAddCodePanel" Spacing="8" Margin="0 14 0 0" IsVisible="{Binding IsAddCodeOpen}">
				<TextBox Name="CheatsNewCodeBox" Text="{Binding NewCode}" PlaceholderText="{l:Translate lblCheatsCodePlaceholder}" />
				<TextBox Text="{Binding NewDescription}" PlaceholderText="{l:Translate lblCheatsDescriptionPlaceholder}" />
				<Border Classes="warning notice" IsVisible="{Binding AddCodeError.Length}">
					<TextBlock Name="CheatsAddCodeError" TextWrapping="Wrap" Text="{Binding AddCodeError}" />
				</Border>
				<Button Name="CheatsAddCodeConfirm" Classes="secondary regular" Content="{l:Translate btnCheatsAdd}" HorizontalAlignment="Right" Click="OnConfirmAddCode" />
			</StackPanel>

			<DockPanel Margin="0 28 0 0">
				<Button Name="CheatsDoneButton" Classes="primary regular" DockPanel.Dock="Right" Content="{l:Translate btnCheatsDone}" Click="OnDone" />
				<Button Name="CheatsAddCodeButton" Classes="secondary regular" HorizontalAlignment="Left" Content="{l:Translate btnCheatsAddCode}" Click="OnAddCode" />
			</DockPanel>
		</StackPanel>
	</Border>
</UserControl>
