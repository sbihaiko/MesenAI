<UserControl xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:l="using:Mesen.Localization"
	xmlns:vm="using:Mesen.ViewModels"
	mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="640"
	x:Class="Mesen.Views.PlayerRomPickerView"
	x:DataType="vm:PlayerRomPickerViewModel"
>
	<!--#1032 (ADR-0264): the Play *Open a game* sheet. It opens on the LIBRARY -
	every openable ROM under the library folders at once, as a grid of vertical
	console-coloured tiles carrying their clean titles (Decisions 1, 2, 6, 7) -
	and the folder browser ADR-0256 Decision 9 built survives inside it, behind
	*Browse a file…* (Decision 11), unchanged: its roots, its walk, its *Make
	this my games folder* row and the first-row focus guard that protects it.

	The two surfaces are the same sheet, not two sheets: B leaves the library and
	walks back out of the browser's roots to the library, so the whole thing is
	reversible from the pad (Decision 3).-->
	<UserControl.Styles>
		<!--Each row sits in its own item container, so the theme's "no hairline
		on the last row" is decided per container here (PlaySelectRomSheetView).-->
		<Style Selector=".player ContentPresenter > Button.row /template/ Rectangle#PART_Separator">
			<Setter Property="IsVisible" Value="True" />
		</Style>
		<Style Selector=".player ContentPresenter:nth-last-child(1) > Button.row /template/ Rectangle#PART_Separator">
			<Setter Property="IsVisible" Value="False" />
		</Style>
		<Style Selector=".player Button.row">
			<Setter Property="Height" Value="44" />
			<Setter Property="Padding" Value="16 0 14 0" />
		</Style>
		<!--The action row is accent, not a place: the sparkle icon and the accent
		text say "this is a press, not a folder", which is what keeps a confirm on
		it from reading as a descend. The ring still lands on content first (the
		focus target skips Action rows), so it is reached on purpose, one Up away.-->
		<Style Selector=".player Button.row.action">
			<Setter Property="Foreground" Value="{StaticResource PlayerTintTextPlayBrush}" />
		</Style>
		<!--A library tile: a vertical ~3:4 cover with the title and the console
		tag under it (Decision 2). The button keeps no chrome of its own, so the
		whole tile is the target and the focus ring the theme already draws is
		what says which one A opens.-->
		<Style Selector=".player Button.library-tile">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Width" Value="112" />
			<Setter Property="Margin" Value="0 0 12 14" />
			<Setter Property="CornerRadius" Value="10" />
		</Style>
		<!--Focus is drawn on exactly one tile at a time, and it is the theme's
		own ring (ADR-0256 Decision 3): the sheet invents no second highlight.-->
		<Style Selector=".player Button.library-tile:focus-visible Border#TileCover">
			<Setter Property="BoxShadow" Value="{StaticResource PlayerFocusRing}" />
		</Style>
		<!--The cover's own title. A generic cover carries it (Decision 6 case 4),
		which is why it is white on the console's colour rather than the sheet's
		own text colour.-->
		<Style Selector=".player TextBlock.library-cover-title">
			<Setter Property="Foreground" Value="White" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="TextAlignment" Value="Center" />
		</Style>
		<Style Selector=".player TextBlock.library-title">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="TextTrimming" Value="CharacterEllipsis" />
			<Setter Property="Margin" Value="2 6 2 0" />
		</Style>
		<Style Selector=".player TextBlock.library-console">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Foreground" Value="{StaticResource PlayerText2Brush}" />
			<Setter Property="TextTrimming" Value="CharacterEllipsis" />
			<Setter Property="Margin" Value="2 1 2 0" />
		</Style>
	</UserControl.Styles>

	<Panel Name="RomPickerBackdrop" Classes="scrim">
		<!--W-P19 is a near-full-window sheet: the grid is the point, and eight
		columns of vertical tiles need the width a 480 px column does not have.-->
		<Border Name="PlayerRomPickerSheet" Classes="sheet" Width="1000" MaxHeight="620" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 24">
			<DockPanel>
				<!--The header: the sheet's one heading, which reads as the library's
				own when the library is up (Decision 8: what it is, then how much it
				holds) and as the sheet's title when the browser is (a place, not a
				count - so no count line and no *Browse a file…* there).-->
				<DockPanel DockPanel.Dock="Top">
					<Button Name="RomPickerBrowseFile" DockPanel.Dock="Right" Classes="secondary regular" Content="{l:Translate btnRomPickerBrowseFile}" Click="OnBrowseFile" IsVisible="{Binding IsLibraryMode}" />
					<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
						<TextBlock Name="RomPickerTitle" Classes="sheet-heading" Text="{Binding SheetHeading}" />
						<TextBlock Name="RomPickerCount" Classes="footnote secondary" Text="{Binding CountText}" VerticalAlignment="Center" IsVisible="{Binding IsLibraryMode}" />
					</StackPanel>
				</DockPanel>
				<TextBlock Classes="subhead secondary" DockPanel.Dock="Top" Text="{l:Translate lblRomPickerHint}" TextWrapping="Wrap" IsVisible="{Binding IsBrowseMode}" />
				<!--The folder being shown. Hidden on the roots list, where the rows
				themselves say where they go.-->
				<TextBlock Name="RomPickerPath" Classes="footnote secondary" DockPanel.Dock="Top" Text="{Binding PathText}" TextTrimming="CharacterEllipsis" IsVisible="{Binding PathText.Length}" Margin="0 10 0 0" />
				<!--The scan, while it runs. Not a row: the pad ignores it.-->
				<TextBlock Name="RomPickerSearching" Classes="footnote secondary" DockPanel.Dock="Top" Text="{Binding SearchingText}" IsVisible="{Binding SearchingText.Length}" Margin="0 10 0 0" />
				<!--What the save left behind, while the folder stays on screen.-->
				<TextBlock Name="RomPickerNotice" Classes="footnote" DockPanel.Dock="Top" Text="{Binding NoticeText}" TextWrapping="Wrap" IsVisible="{Binding NoticeText.Length}" Margin="0 10 0 0" />
				<!--The library's own notice: a scan that hit the count cap says so
				rather than silently dropping games (Decision 9).-->
				<TextBlock Name="RomPickerTruncated" Classes="footnote" DockPanel.Dock="Top" Text="{Binding TruncatedText}" TextWrapping="Wrap" IsVisible="{Binding TruncatedText.Length}" Margin="0 10 0 0" />
				<Button Name="RomPickerBack" DockPanel.Dock="Bottom" Classes="secondary regular" HorizontalAlignment="Right" Margin="0 18 0 0" Content="{l:Translate btnRomPickerBack}" Click="OnBack" />
				<Panel>
					<!--(1) The library: the grid, and the one named empty state
					(Decision 8) - a sentence with the next step, never a blank
					grid.-->
					<DockPanel IsVisible="{Binding IsLibraryMode}">
						<TextBlock Name="RomPickerLibraryEmpty" Classes="subhead secondary" DockPanel.Dock="Bottom" Text="{Binding EmptyText}" TextWrapping="Wrap" Margin="16 12" IsVisible="{Binding EmptyText.Length}" />
						<ScrollViewer HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False" Margin="0 14 0 0">
							<ItemsControl Name="RomPickerGrid" ItemsSource="{Binding Tiles}" XYFocus.NavigationModes="Enabled">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel Orientation="Horizontal" />
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:PlayerLibraryTile">
										<Button Classes="library-tile" Click="OnPlayTile">
											<StackPanel>
												<Border Name="TileCover" Classes="library-cover" Background="{Binding Cover}" Width="104" Height="139" CornerRadius="8">
													<TextBlock Classes="library-cover-title" Text="{Binding Title}" Margin="8" VerticalAlignment="Center" />
												</Border>
												<TextBlock Classes="library-title" Text="{Binding Title}" />
												<TextBlock Classes="library-console" Text="{Binding ConsoleName}" />
											</StackPanel>
										</Button>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
					</DockPanel>

					<!--(2) Browse a file…: ADR-0256 Decision 9's sheet, unchanged.
					DockPanel, not Panel: the empty sentence used to be laid OVER the
					list, and the one folder whose list is a single row - the action
					row - drew the sentence straight through it. Docked to the bottom
					it sits under the list, which is where a sentence about the list
					belongs.-->
					<Border Classes="inset" Margin="0 14 0 0" IsVisible="{Binding IsBrowseMode}">
						<DockPanel>
							<!--A folder with nothing to open; the sheet stays up so Back is
							still the visible next step (W-X2: a sentence, never a code).
							ContentCount decides this, so the action row does not hide it.-->
							<TextBlock Name="RomPickerEmpty" Classes="subhead secondary" DockPanel.Dock="Bottom" Text="{Binding EmptyText}" TextWrapping="Wrap" Margin="16 12" IsVisible="{Binding EmptyText.Length}" />
							<ScrollViewer HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
								<ItemsControl Name="RomPickerList" ItemsSource="{Binding Rows}" XYFocus.NavigationModes="Enabled">
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="vm:PlayerRomPickerRow">
											<Button Classes="row text" Classes.action="{Binding IsAction}" Click="OnChoose">
												<DockPanel>
													<PathIcon Classes="leading" DockPanel.Dock="Left" Data="{StaticResource PlayerIconFolder}" IsVisible="{Binding IsFolder}" />
													<PathIcon Classes="leading" DockPanel.Dock="Left" Data="{StaticResource PlayerIconPlay}" IsVisible="{Binding IsGame}" />
													<PathIcon Classes="leading" DockPanel.Dock="Left" Data="{StaticResource PlayerIconSparkle}" IsVisible="{Binding IsAction}" />
													<TextBlock Classes="title" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
												</DockPanel>
											</Button>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</ScrollViewer>
						</DockPanel>
					</Border>
				</Panel>
			</DockPanel>
		</Border>
	</Panel>
</UserControl>
