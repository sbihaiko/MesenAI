<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:Mesen.ViewModels"
	xmlns:l="using:Mesen.Localization"
	mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="44"
	x:DataType="vm:RemasterWorkspaceViewModel"
	x:Class="Mesen.Views.RemasterRecordingStrip"
>
	<!--G.3 (PRD Part B §13.5.3 W-R2): recording in progress. The game fills
	the rest of the window inside Remaster (no pause overlay, no slots); this
	strip is the one pill and Stop (1 control, rule 2). It sits above the game,
	not over it, because the native renderer draws above Avalonia content.-->
	<Border Name="RemasterRecordingStripBorder" Background="#202020" Padding="12 6">
		<Panel>
		<DockPanel IsVisible="{Binding IsRecording}">
			<Button Name="RemasterStopRecordingButton" DockPanel.Dock="Right" Content="{l:Translate btnStopRecording}" Click="OnStop" />
			<StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
				<TextBlock Text="●" Foreground="#FF3B30" VerticalAlignment="Center" />
				<TextBlock Name="RemasterRecordingPill" Text="{Binding RecordingPill}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" />
				<TextBlock Text="{l:Translate lblRecordingRemasterTag}" Foreground="#C9A0FF" VerticalAlignment="Center" />
				<TextBlock Text="{l:Translate lblRecordingHint}" Foreground="#CCFFFFFF" VerticalAlignment="Center" />
			</StackPanel>
		</DockPanel>
		<!--G.6: the same strip shows a build in the game - one pill and Back to
		Project (Esc does the same).-->
		<DockPanel Name="RemasterShowingStrip" IsVisible="{Binding IsShowingBuild}">
			<Button Name="RemasterBackToProjectButton" DockPanel.Dock="Right" Content="{l:Translate btnBackToProject}" Click="OnBack" />
			<StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
				<TextBlock Text="{l:Translate lblRecordingRemasterTag}" Foreground="#C9A0FF" FontWeight="Bold" VerticalAlignment="Center" />
				<TextBlock Name="RemasterShowingPill" Text="{Binding ShowingPill}" Foreground="White" VerticalAlignment="Center" />
				<TextBlock Text="{l:Translate lblShowingHint}" Foreground="#CCFFFFFF" VerticalAlignment="Center" />
			</StackPanel>
		</DockPanel>
		</Panel>
	</Border>
</UserControl>
