<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:Mesen.ViewModels"
	xmlns:l="using:Mesen.Localization"
	mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="220"
	x:DataType="vm:RemasterWorkspaceViewModel"
	x:Class="Mesen.Views.RemasterComposeSheet"
	IsVisible="{Binding IsComposeSheetVisible}"
>
	<!--G.7 (PRD Part B §13.5.3 W-R7, ADR-0165): the composer is a separate
	tool in its own window. Cancel / Open Composer ↗ = 2 elements; without
	adjacency.json the hint says to record again and the button is disabled
	(rule 4). Esc closes it.-->
	<Border Name="RemasterComposeCard" Background="#262626" CornerRadius="8" Padding="16" MaxWidth="560" HorizontalAlignment="Left">
		<StackPanel Spacing="10">
			<TextBlock Text="{l:Translate lblComposeTitle}" FontSize="16" FontWeight="Bold" />
			<TextBlock Text="{l:Translate lblComposeBody}" />
			<TextBlock Name="RemasterComposeHint" Text="{Binding ComposeHint}" />
			<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
				<Button Name="RemasterComposeCancelButton" Content="{l:Translate btnComposeCancel}" Click="OnCancel" />
				<StackPanel Spacing="2" MaxWidth="240">
					<Button Name="RemasterOpenComposerButton" Content="{l:Translate btnOpenComposer}" Classes="accent" IsEnabled="{Binding OpenComposer.IsEnabled}" Click="OnOpen" />
					<TextBlock Name="RemasterOpenComposerReason" Classes="reason" Text="{Binding OpenComposer.Reason}" IsVisible="{Binding OpenComposer.HasReason}" />
				</StackPanel>
			</StackPanel>
		</StackPanel>
	</Border>
</UserControl>
