<UserControl xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:l="using:Mesen.Localization"
	xmlns:v="using:Mesen.Views"
	xmlns:vm="using:Mesen.ViewModels"
	mc:Ignorable="d"
	x:Class="Mesen.Views.PlayerSettingsSheetView"
	x:DataType="vm:ConfigViewModel"
>
	<UserControl.DataTemplates>
		<DataTemplate DataType="{x:Type vm:PlayerWindowSettingsViewModel}">
			<v:PlayerWindowSettingsView />
		</DataTemplate>
		<DataTemplate DataType="{x:Type vm:LookConfigViewModel}">
			<v:LookConfigView />
		</DataTemplate>
		<DataTemplate DataType="{x:Type vm:PlayerAudioSettingsViewModel}">
			<v:PlayerAudioSettingsView />
		</DataTemplate>
		<DataTemplate DataType="{x:Type vm:PlayerControlsSettingsViewModel}">
			<v:PlayerControlsSettingsView />
		</DataTemplate>
	</UserControl.DataTemplates>

	<!--ADR-0249 (PRD Part B §13.5.2 W-P8, W-P10): Player mode's Settings is a
	sheet inside the main window, over the dimmed game like the other Play
	sheets - 480 wide, as high as the tab needs (PlayerSettingsEssentials.
	SheetHeight), 24 px under the bar. The title, the segmented Window | Video |
	Audio | Controls strip, the page, and one Done that keeps the changes (Esc
	does the same, back to W-P4). Advanced keeps the classic ConfigWindow.-->
	<Border
		Name="PlayerSettingsSheet"
		Classes="sheet"
		Width="480"
		Height="{Binding PlayerSheetHeight}"
		HorizontalAlignment="Center"
		VerticalAlignment="Top"
		Margin="0 24 0 0"
		Padding="19 17 19 19"
	>
		<Grid RowDefinitions="Auto,*">
			<Grid.Styles>
				<!--The page stops above the hint and the Done row; Video's own
				footer (Hold to Compare, W-P10) shares Done's row, left of it.-->
				<Style Selector="TabControl#PlayerSettingsTabs">
					<Setter Property="Margin" Value="0 0 0 62" />
				</Style>
				<Style Selector="TabControl#PlayerSettingsTabs.look">
					<Setter Property="Margin" Value="0" />
				</Style>
			</Grid.Styles>
			<TextBlock Grid.Row="0" Name="lblPlayerSettingsTitle" Classes="title3" Text="{l:Translate lblPlayerSettingsTitle}" Margin="0 0 0 14" />
			<!--G.4 (W-P8): the strip in PlayerSettingsEssentials.Tabs order -
			Window (the window) and Video (the pixels) are the two halves of
			Advanced's Video tab, the pixels half being the page Advanced calls
			Look (ADR-0246). The XAML names below keep the older `PlayerDisplay`
			/ `PlayerLook` spelling; only the labels follow the strip.-->
			<TabControl Grid.Row="1" Name="PlayerSettingsTabs" Classes="segmented" Classes.look="{Binding IsPlayerVideoTab}" SelectedIndex="{Binding PlayerTabIndex, Mode=TwoWay}" Padding="0 18 0 0">
				<TabItem Name="tabPlayerWindow" Header="{l:Translate tabDisplay}" Content="{Binding Display}" />
				<TabItem Name="tabPlayerVideo" Header="{l:Translate tabLook}" Content="{Binding Look}" />
				<TabItem Name="tabPlayerAudio" Header="{l:Translate tabAudio}" Content="{Binding PlayerAudio}" />
				<TabItem Name="tabPlayerControls" Header="{l:Translate tabPlayerControls}" Content="{Binding PlayerControls}" />
			</TabControl>
			<!--G.4 (W-P8): rule 10 applied to settings - one line right under the
			group, then Done. Window shows the Options hint; Audio and Controls
			put "More in Options…" there (it expands to that tab's classic page,
			as Video's does). Video's footer is its Hold to Compare (W-P10).-->
			<StackPanel Grid.Row="1" VerticalAlignment="Bottom">
				<TextBlock Name="lblPlayerSettingsEverythingElse" Classes="subhead secondary" Text="{l:Translate lblPlayerSettingsEverythingElse}" Margin="2 0 0 12" IsVisible="{Binding IsPlayerHintTab}" />
				<Button Name="btnPlayerSettingsMoreInOptions" Classes="plain small" HorizontalAlignment="Left" Margin="-9 -6 0 6" Click="OnMoreInOptions" IsVisible="{Binding IsPlayerMoreTab}" Content="{l:Translate btnPlayerSettingsMoreInOptions}" />
				<Button Name="btnPlayerSettingsDone" Classes="primary regular wide" HorizontalAlignment="Right" Click="OnDone" Content="{l:Translate btnPlayerSettingsDone}" />
			</StackPanel>
		</Grid>
	</Border>
</UserControl>
