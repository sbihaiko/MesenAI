<UserControl xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:c="using:Mesen.Controls"
	xmlns:l="using:Mesen.Localization"
	xmlns:v="using:Mesen.Views"
	xmlns:vm="using:Mesen.ViewModels"
	mc:Ignorable="d"
	x:Class="Mesen.Views.PlayerSettingsSheetView"
	x:DataType="vm:ConfigViewModel"
>
	<UserControl.DataTemplates>
		<DataTemplate DataType="{x:Type vm:PlayerWindowSettingsViewModel}">
			<v:PlayerWindowSettingsView />
		</DataTemplate>
		<DataTemplate DataType="{x:Type vm:LookConfigViewModel}">
			<v:LookConfigView />
		</DataTemplate>
		<DataTemplate DataType="{x:Type vm:PlayerAudioSettingsViewModel}">
			<v:PlayerAudioSettingsView />
		</DataTemplate>
		<DataTemplate DataType="{x:Type vm:PlayerControlsSettingsViewModel}">
			<v:PlayerControlsSettingsView />
		</DataTemplate>
		<DataTemplate DataType="{x:Type vm:PlayerSystemSettingsViewModel}">
			<v:PlayerSystemSettingsView />
		</DataTemplate>
	</UserControl.DataTemplates>

	<!--ADR-0249 (PRD Part B §13.5.2 W-P8, W-P10): Player mode's Settings is a
	sheet inside the main window, over the dimmed game like the other Play
	sheets - 480 wide, as high as the tab needs (PlayerSettingsEssentials.
	SheetHeight), 24 px under the bar. The title, the segmented Display | Look |
	Audio | Controls | System strip, the page, and one Done that keeps the
	changes (Esc does the same, back to W-P4). Advanced keeps the classic
	ConfigWindow. ADR-0256 Decision 8 added System: the first run's storage and
	keyboard-preset choices, which no longer stand in front of the window.
	#1123 (ADR-0269 Decision 6): both sides of the box are capped against the
	room the host gives the sheet - MaxHeight already was, MaxWidth now is - so
	at a larger Interface size in a window too small for 480 * factor the sheet
	shrinks with the window instead of hanging off both sides of it and taking
	Done, past the right edge, with it. 480 stays the width wherever it fits.-->
	<Border
		Name="PlayerSettingsSheet"
		Classes="sheet"
		Width="480"
		Height="{Binding PlayerSheetHeight}"
		MaxHeight="{Binding $parent[UserControl].Bounds.Height, Converter={x:Static c:RoomLeftConverter.Instance}, ConverterParameter=32}"
		MaxWidth="{Binding $parent[UserControl].Bounds.Width, Converter={x:Static c:RoomLeftConverter.Instance}, ConverterParameter=32}"
		HorizontalAlignment="Center"
		VerticalAlignment="Top"
		Margin="0 24 0 0"
		Padding="19 17 19 19"
	>
		<Grid RowDefinitions="Auto,*">
			<Grid.Styles>
				<!--The page stops above the hint and the Done row; Video's own
				footer (Hold to Compare, W-P10) shares Done's row, left of it.-->
				<Style Selector="TabControl#PlayerSettingsTabs">
					<Setter Property="Margin" Value="0 0 0 62" />
				</Style>
				<Style Selector="TabControl#PlayerSettingsTabs.look">
					<Setter Property="Margin" Value="0" />
				</Style>
				<!--Look is a DockPanel with its own scroller and Hold to Compare
				docked below it (W-P10): an outer scroller would give it unbounded
				height, so only the list tabs scroll here.-->
				<Style Selector="ScrollViewer.pageScroll">
					<Setter Property="VerticalScrollBarVisibility" Value="Auto" />
				</Style>
				<Style Selector="TabControl#PlayerSettingsTabs.look ScrollViewer.pageScroll">
					<Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
				</Style>
			</Grid.Styles>
			<TextBlock Grid.Row="0" Name="lblPlayerSettingsTitle" Classes="title3" Text="{l:Translate lblPlayerSettingsTitle}" Margin="0 0 0 14" />
			<!--G.4 (W-P8): the strip in PlayerSettingsEssentials.Tabs order -
			Display (the window) and Look (the pixels) are the two halves of
			Advanced's Video tab, the pixels half being the page Advanced calls
			Look (ADR-0246). The XAML names below keep the older `PlayerDisplay`
			/ `PlayerLook` spelling; only the labels follow the strip.-->
			<TabControl Grid.Row="1" Name="PlayerSettingsTabs" Classes="segmented" Classes.look="{Binding IsPlayerVideoTab}" SelectedIndex="{Binding PlayerTabIndex, Mode=TwoWay}" Padding="0 18 0 0">
				<!--ADR-0269 Decision 6: the page rows scroll when the sheet is
				capped by the window (a larger Interface size); the strip above and
				Done below stay put.-->
				<TabControl.ContentTemplate>
					<DataTemplate>
						<ScrollViewer Classes="pageScroll" HorizontalScrollBarVisibility="Disabled">
							<ContentControl Content="{Binding}" />
						</ScrollViewer>
					</DataTemplate>
				</TabControl.ContentTemplate>
				<TabItem Name="tabPlayerWindow" Header="{l:Translate tabDisplay}" Content="{Binding Display}" />
				<TabItem Name="tabPlayerVideo" Header="{l:Translate tabLook}" Content="{Binding Look}" />
				<TabItem Name="tabPlayerAudio" Header="{l:Translate tabAudio}" Content="{Binding PlayerAudio}" />
				<TabItem Name="tabPlayerControls" Header="{l:Translate tabPlayerControls}" Content="{Binding PlayerControls}" />
				<!--ADR-0256 Decision 8: the first run's two questions, moved off
				the startup path and onto the pad's. Named tabPlayerSystem, not
				tabPlayerWindow's older `PlayerDisplay` spelling: the names here
				are the strip's own, and this one is new.-->
				<TabItem Name="tabPlayerSystem" Header="{l:Translate tabSystem}" Content="{Binding System}" />
			</TabControl>
			<!--G.4 (W-P8): rule 10 applied to settings - one line right under the
			group, then Done. Window shows the Options hint; Audio and Controls
			put "More in Options…" there. Audio expands to its classic page, as
			Video's does; Controls' opens the Play Controller sheet (ADR-0255
			slice 1), and only a view nobody wired - the designer, a sheet tested
			alone - still expands to the classic page. Video's footer is its Hold
			to Compare (W-P10).-->
			<StackPanel Grid.Row="1" VerticalAlignment="Bottom">
				<TextBlock Name="lblPlayerSettingsEverythingElse" Classes="subhead secondary" Text="{l:Translate lblPlayerSettingsEverythingElse}" Margin="2 0 0 12" IsVisible="{Binding IsPlayerHintTab}" />
				<Button Name="btnPlayerSettingsMoreInOptions" Classes="plain small" HorizontalAlignment="Left" Margin="-9 -6 0 6" Click="OnMoreInOptions" IsVisible="{Binding IsPlayerMoreTab}" Content="{l:Translate btnPlayerSettingsMoreInOptions}" />
				<!--#910 (§13.5.2 W-P4: "Exit fullscreen moves into Settings"): the
				explicit way back to windowed, in Done's row, only while the window is
				fullscreen and on Window (PlayerSettingsEssentials.ShowsExitFullscreen).
				Look's Hold to Compare holds this place on its own tab.-->
				<DockPanel>
					<Button Name="btnPlayerSettingsExitFullscreen" DockPanel.Dock="Left" Classes="secondary regular" Click="OnExitFullscreen" IsVisible="{Binding ShowsPlayerExitFullscreen}" Content="{l:Translate btnPlayerSettingsExitFullscreen}" />
					<Button Name="btnPlayerSettingsDone" Classes="primary regular wide" HorizontalAlignment="Right" Click="OnDone" Content="{l:Translate btnPlayerSettingsDone}" />
				</DockPanel>
			</StackPanel>
		</Grid>
	</Border>
</UserControl>
