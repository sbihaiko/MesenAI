<UserControl xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:l="using:Mesen.Localization"
	xmlns:vm="using:Mesen.ViewModels"
	mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="640"
	x:Class="Mesen.Views.PlayerControllerSheetView"
	x:DataType="vm:ControllerSheetViewModel"
>
	<!--ADR-0255 slice 1 (PRD Part B §13.5.2 W-P17): the Controller sheet, over
	the paused game. It shows the live pad and its values by reusing the host
	tester (GamepadTesterViewModel - its own readouts, its own chip brush) and
	W-P15's pad drawing: every key here is placed by ControllerPadLayout, and the
	style block below is W-P15's with this sheet's one extra state (`.lit`, the
	key the pad is pressing) instead of its current/done pair. There is no third
	renderer: the geometry and the tokens are the same ones, the item type is
	what differs (a step vs a live light).-->
	<UserControl.Styles>
		<Style Selector="ItemsControl#ControllerSheetKeys > ContentPresenter" x:DataType="vm:ControllerPadLight">
			<Setter Property="Canvas.Left" Value="{Binding Left}" />
			<Setter Property="Canvas.Top" Value="{Binding Top}" />
		</Style>
		<Style Selector="Border#ControllerSheetKey">
			<Setter Property="Background" Value="{StaticResource PlayerPadButtonBrush}" />
			<Setter Property="CornerRadius" Value="{StaticResource PlayerRadiusSmall}" />
		</Style>
		<Style Selector="Border#ControllerSheetKey.dpad">
			<Setter Property="Background" Value="{StaticResource PlayerPadKeyBrush}" />
			<Setter Property="CornerRadius" Value="{StaticResource PlayerRadiusPadKey}" />
		</Style>
		<Style Selector="Border#ControllerSheetKey.round">
			<Setter Property="CornerRadius" Value="{StaticResource PlayerRadiusPadRound}" />
		</Style>
		<Style Selector="Border#ControllerSheetKey.shoulder">
			<Setter Property="CornerRadius" Value="{StaticResource PlayerRadiusControl}" />
		</Style>
		<Style Selector="Border#ControllerSheetKey.lit">
			<Setter Property="Background" Value="{StaticResource PlayerTintPlayBrush}" />
		</Style>
		<!--A lit round key is drawn against the pad's own light fill, as W-P15's
		current step is, or the tint alone reads as a hole in the pad.-->
		<Style Selector="Border#ControllerSheetKey.lit.round">
			<Setter Property="BorderBrush" Value="{StaticResource PlayerCardBrush}" />
			<Setter Property="BorderThickness" Value="3" />
		</Style>
		<!--The keys are dark or tinted: the label is always white, never inherited.-->
		<Style Selector="TextBlock#ControllerSheetKeyLabel">
			<Setter Property="Foreground" Value="{StaticResource PlayerCardBrush}" />
			<Setter Property="FontSize" Value="{StaticResource PlayerFontBody}" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="HorizontalAlignment" Value="Center" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<!--ADR-0255 slice 3: the two lights of a REMAP row - what the pad sends and
		what the port receives. Two dots in the same idiom as the drawn pad's keys
		(a dark key, a lit key), because that is the same language on the same
		sheet: dark is "not now", tinted is "now".-->
		<Style Selector="Border.remap-light">
			<Setter Property="Width" Value="10" />
			<Setter Property="Height" Value="10" />
			<Setter Property="CornerRadius" Value="5" />
			<Setter Property="Background" Value="{StaticResource PlayerPadKeyBrush}" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<Style Selector="Border.remap-light.lit">
			<Setter Property="Background" Value="{StaticResource PlayerTintPlayBrush}" />
		</Style>
	</UserControl.Styles>

	<Border Name="PlayerControllerSheet" Classes="sheet" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="19 17 19 19" IsVisible="{Binding IsVisible}">
		<StackPanel XYFocus.NavigationModes="Enabled">
			<TextBlock Classes="title3" Text="{l:Translate lblControllerSheetTitle}" />
			<TextBlock Classes="body secondary" Text="{l:Translate lblControllerSheetIntro}" TextWrapping="Wrap" Margin="0 8 0 0" />

			<!--The pad: W-P15's drawing, its keys lit by the pad's own buttons.-->
			<Border Name="ControllerSheetPad" Background="{StaticResource PlayerPadBrush}" CornerRadius="{StaticResource PlayerRadiusPad}" Width="340" Height="140" HorizontalAlignment="Center" Margin="0 16 0 0">
				<Panel>
					<Canvas>
						<Border Canvas.Left="58" Canvas.Top="58" Width="24" Height="24" Background="{StaticResource PlayerPadKeyBrush}" />
					</Canvas>
					<ItemsControl Name="ControllerSheetKeys" ItemsSource="{Binding PadKeys}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<Canvas />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="vm:ControllerPadLight">
								<Border Name="ControllerSheetKey" Width="{Binding Width}" Height="{Binding Height}"
									Classes.dpad="{Binding IsDPad}" Classes.round="{Binding IsRound}" Classes.shoulder="{Binding IsShoulder}"
									Classes.lit="{Binding IsLit}"
									AutomationProperties.Name="{Binding Name}" ToolTip.Tip="{Binding Name}">
									<TextBlock Name="ControllerSheetKeyLabel" Text="{Binding Name}" IsVisible="{Binding ShowsLabel}" />
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</Panel>
			</Border>

			<!--Which pad this is, or why the pad is dark. Slice 2: with more than
			one pad the line under it is a picker, not a count - the sheet says
			which pad it is showing by letting the player choose.-->
			<TextBlock Name="ControllerSheetPadName" Classes="headline" Text="{Binding Pad.Name}" IsVisible="{Binding HasPad}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0 14 0 0" />
			<TextBlock Name="ControllerSheetPadInfo" Classes="subhead secondary" Text="{Binding Pad.InfoText}" IsVisible="{Binding HasPad}" HorizontalAlignment="Center" />
			<ListBox Name="ControllerSheetPadPicker" Classes="segmented" IsVisible="{Binding ShowPadPicker}" HorizontalAlignment="Center" Margin="0 10 0 0"
				ItemsSource="{Binding Tester.Gamepads}" SelectedIndex="{Binding SelectedPadIndex, Mode=TwoWay}">
				<ListBox.ItemTemplate>
					<DataTemplate x:DataType="vm:GamepadTestItem">
						<TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
			<TextBlock Name="ControllerSheetNoPad" Classes="body secondary" Text="{l:Translate lblControllerSheetNoPad}" IsVisible="{Binding !HasPad}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0 14 0 0" />

			<!--The values: the tester's own readouts, the ones its Test tab shows,
			so a button this sheet's pad has no key for (X, Y, the triggers, the
			stick clicks) is still visible.-->
			<Border Name="ControllerSheetPadValues" Classes="inset" IsVisible="{Binding HasPad}" Margin="0 14 0 0">
				<StackPanel>
					<ItemsControl Name="ControllerSheetButtons" ItemsSource="{Binding Pad.Buttons}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="vm:GamepadButtonState">
								<Border Name="ControllerSheetButtonChip" CornerRadius="3" Padding="6 2" Margin="2" Background="{Binding IsPressedBrush}">
									<TextBlock Text="{Binding Label}" FontSize="11" />
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					<Grid ColumnDefinitions="Auto,Auto" Margin="2 8 0 0">
						<StackPanel>
							<TextBlock Classes="subhead" Text="{l:Translate lblControllerSheetLeftStick}" />
							<TextBlock Name="ControllerSheetLeftStick" Text="{Binding Pad.LeftStickReadout}" Margin="0 2 0 0" />
						</StackPanel>
						<StackPanel Grid.Column="1" Margin="24 0 0 0">
							<TextBlock Classes="subhead" Text="{l:Translate lblControllerSheetRightStick}" />
							<TextBlock Name="ControllerSheetRightX" Text="{Binding Pad.RightX, StringFormat='X: {0}'}" Margin="0 2 0 0" />
							<TextBlock Name="ControllerSheetRightY" Text="{Binding Pad.RightY, StringFormat='Y: {0}'}" />
						</StackPanel>
					</Grid>
				</StackPanel>
			</Border>

			<!--Slice 2 (W-P17): PLAYERS - one row per port, naming the device whose
			keys live under it (read off the ports; there is no second table of who
			is P1). Shown only with more than one pad: with none the keyboard
			section below says what plays, and with one there is nothing to assign.
			A row's device is read *now*, from the connection order the key codes
			carry - not a stable identity until slice 5 repairs a reconnect.-->
			<StackPanel Name="ControllerSheetPlayers" IsVisible="{Binding ShowPlayers}" Margin="0 14 0 0">
				<TextBlock Classes="group-label" Text="{l:Translate lblControllerSheetPlayers}" />
				<Border Classes="group" Margin="0 8 0 0">
					<StackPanel>
						<ItemsControl Name="ControllerSheetPlayerRows" ItemsSource="{Binding Players}">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="vm:ControllerSheetPlayerRow">
									<Button Name="ControllerSheetPlayerRow" Classes="row text" Click="OnAssignPlayer">
										<DockPanel>
											<Border Width="12" Height="12" CornerRadius="6" Background="{Binding Color}" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0 0 10 0" />
											<TextBlock Classes="value" DockPanel.Dock="Right" Text="{Binding DeviceName}" />
											<TextBlock Classes="title" Text="{Binding Label}" />
										</DockPanel>
									</Button>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>
				</Border>
				<TextBlock Name="ControllerSheetPlayersHint" Classes="subhead secondary" Text="{l:Translate lblControllerSheetPlayersHint}" TextWrapping="Wrap" Margin="2 8 0 0" />
				<TextBlock Name="ControllerSheetAssignNote" Classes="subhead" Text="{Binding AssignNote}" IsVisible="{Binding AssignNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" Margin="2 8 0 0" />
			</StackPanel>

			<!--The keyboard case (ADR-0255 slice 2): with no pad the sheet says
			what the keyboard plays, and offers the preset back when nothing is
			bound anywhere (the same guard the load path uses).-->
			<StackPanel Name="ControllerSheetKeyboard" IsVisible="{Binding ShowKeyboard}" Margin="0 14 0 0">
				<TextBlock Classes="group-label" Text="{l:Translate lblControllerSheetKeyboard}" />
				<TextBlock Name="ControllerSheetKeyboardText" Classes="body secondary" Text="{Binding KeyboardText}" TextWrapping="Wrap" Margin="2 8 0 0" />
				<Button Name="ControllerSheetKeyboardRestore" Classes="secondary small" HorizontalAlignment="Left" Margin="0 10 0 0" IsVisible="{Binding CanRestoreKeyboard}" Click="OnRestoreKeyboard" Content="{l:Translate btnControllerSheetKeyboardRestore}" />
			</StackPanel>

			<!--Slice 3 (W-P17): REMAP, a mode of this sheet rather than a dialog.
			Pick a row, press a control, Esc cancels. The rows are the console's own
			controls; each carries two lights - what the pad sends and what the port
			receives - so a wrong binding is visible here and nowhere else. The
			pad's navigation controls (Confirm, Back, the D-pad) are not offered:
			they are ADR-0256 Decision 4, and a capture that took one is refused and
			says so.-->
			<StackPanel Name="ControllerSheetRemap" IsVisible="{Binding ShowRemap}" Margin="0 14 0 0">
				<TextBlock Classes="group-label" Text="{l:Translate lblControllerSheetRemap}" />
				<TextBlock Classes="subhead secondary" Text="{l:Translate lblControllerSheetRemapHint}" TextWrapping="Wrap" Margin="2 6 0 0" />
				<Border Classes="group" Margin="0 8 0 0">
					<ItemsControl Name="ControllerSheetRemapRows" ItemsSource="{Binding RemapRows}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="vm:ControllerSheetRemapRow">
								<Button Name="ControllerSheetRemapRow" Classes="row text" Click="OnRemapRow">
									<DockPanel>
										<!--Right to left: the port's light, the pad's light, then
										the button this control is bound to.-->
										<Border Name="ControllerSheetRemapPortLight" Classes="remap-light" Classes.lit="{Binding PortLit}"
											DockPanel.Dock="Right" Margin="8 0 0 0" ToolTip.Tip="{l:Translate lblControllerSheetRemapPortLight}" />
										<Border Name="ControllerSheetRemapPadLight" Classes="remap-light" Classes.lit="{Binding PadLit}"
											DockPanel.Dock="Right" Margin="8 0 0 0" ToolTip.Tip="{l:Translate lblControllerSheetRemapPadLight}" />
										<TextBlock Classes="value" DockPanel.Dock="Right" Text="{Binding BoundName}" Margin="0 0 8 0" TextTrimming="CharacterEllipsis" />
										<TextBlock Classes="title" Text="{Binding Label}" />
									</DockPanel>
								</Button>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</Border>
				<TextBlock Name="ControllerSheetRemapNote" Classes="subhead secondary" Text="{Binding RemapNote}"
					IsVisible="{Binding RemapNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" Margin="2 8 0 0" />
			</StackPanel>

			<!--Slice 4 (W-P17): EXTRA BUTTONS - the pad's spare controls carrying the
			emulator's own actions, for a pad with more buttons than the console needs
			(the user's own requirement: "se o jostick tiver mais botoes que o nitendo
			quero poder atribuir outros controles como retroceder, avancar,
			compartilhar, home"). Same capture as REMAP above - one press, one bind, Esc
			cancels - and the same gate: dark without a pad or without a player port. A
			row's binding is the shortcut's own PadBinding slot, and the clear button
			beside it gives that slot back.-->
			<StackPanel Name="ControllerSheetExtra" IsVisible="{Binding ShowExtra}" Margin="0 14 0 0">
				<TextBlock Classes="group-label" Text="{l:Translate lblControllerSheetExtra}" />
				<TextBlock Classes="subhead secondary" Text="{l:Translate lblControllerSheetExtraHint}" TextWrapping="Wrap" Margin="2 6 0 0" />
				<Border Classes="group" Margin="0 8 0 0">
					<ItemsControl Name="ControllerSheetExtraRows" ItemsSource="{Binding ExtraRows}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="vm:ControllerSheetExtraRow">
								<Grid ColumnDefinitions="*,Auto">
									<Button Name="ControllerSheetExtraRow" Classes="row text" Grid.Column="0" Click="OnExtraRow">
										<DockPanel>
											<TextBlock Classes="value" DockPanel.Dock="Right" Text="{Binding BoundName}" Margin="0 0 8 0" TextTrimming="CharacterEllipsis" />
											<TextBlock Classes="title" Text="{Binding Label}" />
										</DockPanel>
									</Button>
									<!--The forward key the row writes, so the action is not left
									without a way back to the keyboard alone. Nothing to clear on
									an unbound row, so it is not there.-->
									<Button Name="ControllerSheetExtraClear" Classes="plain small" Grid.Column="1" Margin="8 0 0 0"
										IsVisible="{Binding HasBinding}" Click="OnExtraClear" Content="{l:Translate btnControllerSheetExtraClear}"
										ToolTip.Tip="{l:Translate btnControllerSheetExtraClear}" />
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</Border>
				<TextBlock Name="ControllerSheetExtraNote" Classes="subhead secondary" Text="{Binding ExtraNote}"
					IsVisible="{Binding ExtraNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" Margin="2 8 0 0" />
			</StackPanel>
			<DockPanel Margin="0 16 0 0">
				<Button Name="ControllerSheetMoreInOptions" Classes="plain small" DockPanel.Dock="Left" Margin="-9 0 0 0" Click="OnMoreInOptions" Content="{l:Translate btnControllerSheetMoreInOptions}" />
				<Button Name="ControllerSheetDone" Classes="primary regular" HorizontalAlignment="Right" Click="OnDone" Content="{l:Translate btnControllerSheetDone}" />
			</DockPanel>
		</StackPanel>
	</Border>
</UserControl>
