<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:Mesen.ViewModels"
	xmlns:l="using:Mesen.Localization"
	mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="160"
	x:DataType="vm:PlayerAudioSettingsViewModel"
	x:Class="Mesen.Views.PlayerAudioSettingsView"
>
	<!--G.4 (W-P8): Settings › Audio - three rows in Display's pattern: the
	Sound switch, Volume, the Output device popup; Menu sounds (#1105) is a fourth only while the host can play it. A device set in Options
	that is not enumerated now stays the current item. Equalizer, reverb,
	crossfeed, latency and sample rate are "More in Options…".
	#1123 (ADR-0269 Decision 6): a row is a Grid whose first column is Auto and
	whose last is the star, not a DockPanel with a right-docked control and the
	label left to eat what is left: at 1.5 in 512x505 the page gives a row about
	220 px, and a 200 px popup (or a 150 px slider beside its 34 px readout)
	docked right left the label 20 px to draw 91 px of text in. An Auto column
	holds the label at the width its text needs, and the star gives the control
	the rest - its drawn width wherever there is room for it, less when there is
	not, by the same cap the sheet itself takes. The readout keeps its own Auto
	column, so the slider shrinks first.-->
	<Border Name="AudioSettingsGroup" Classes="group inset" VerticalAlignment="Top">
		<StackPanel XYFocus.NavigationModes="Enabled">
			<Grid Classes="setting-row" ColumnDefinitions="Auto,*">
				<TextBlock Grid.Column="0" Classes="callout" Text="{l:Translate lblAudioSound}" VerticalAlignment="Center" />
				<ToggleSwitch Grid.Column="1" Name="chkAudioEnabled" IsChecked="{Binding Config.EnableAudio}" HorizontalAlignment="Right" VerticalAlignment="Center" />
			</Grid>
			<Separator Classes="row-hairline" />
			<Grid Classes="setting-row" ColumnDefinitions="Auto,*,Auto">
				<TextBlock Grid.Column="0" Classes="callout" Text="{l:Translate lblAudioVolume}" VerticalAlignment="Center" />
				<Slider Grid.Column="1" Name="sldAudioVolume" MaxWidth="150" Minimum="0" Maximum="100" Value="{Binding Volume}" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
				<TextBlock Grid.Column="2" Name="txtAudioVolume" Classes="callout" Width="34" TextAlignment="Right" Text="{Binding Volume, StringFormat={}{0:0}}" VerticalAlignment="Center" />
			</Grid>
			<Separator Classes="row-hairline" />
			<Grid Classes="setting-row" ColumnDefinitions="Auto,*">
				<TextBlock Grid.Column="0" Classes="callout" Text="{l:Translate lblAudioOutput}" VerticalAlignment="Center" />
				<ComboBox Grid.Column="1" Name="cboAudioDevice" Classes="popup" MaxWidth="200" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
			</Grid>
			<Separator Classes="row-hairline" IsVisible="{Binding MenuSoundsAvailable}" />
			<Grid Classes="setting-row" ColumnDefinitions="Auto,*" IsVisible="{Binding MenuSoundsAvailable}">
				<TextBlock Grid.Column="0" Classes="callout" Text="{l:Translate lblAudioMenuSounds}" VerticalAlignment="Center" />
				<ToggleSwitch Grid.Column="1" Name="chkAudioMenuSounds" IsChecked="{Binding Config.MenuSounds}" HorizontalAlignment="Right" VerticalAlignment="Center" />
			</Grid>
		</StackPanel>
	</Border>
</UserControl>
