<UserControl xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:l="using:Mesen.Localization"
	xmlns:vm="using:Mesen.ViewModels"
	mc:Ignorable="d"
	x:Class="Mesen.Views.PlayerEnhancementsSheetView"
	x:DataType="vm:MainWindowViewModel"
>
	<!--G.4 (PRD Part B §13.5.2 W-P7; P.7 §6.1 minus Hi-res filter): the four
	switches edit a draft (EnhModernInstruments…EnhOverclock) that starts from
	what is applied; the one button applies it through the existing
	SetModernInstruments / ToggleLayer / ToggleWideScrn / ToggleOverclock paths and names the biggest restart it
	causes (EnhancementsSheet.Pending, ADR-0244 Decision 3). Overclock is shown
	disabled with its reason where the console has no overclock knob (rule 4).
	Hi-res filter lives once, as Settings › Look › Pixels (ADR-0246).-->
	<!--ADR-0249 (W-P7): a light sheet - the four switches and the Pack row in an
	inset list (CheckBox.switch rows, "Applies on reload" under Border, the
	overclock reason under Overclock; Pack opens W-P6/W-P5, where the
	per-game Textures and Music live), the Look hint, and the one button.-->
	<Border
		Name="PlayerEnhancementsPanel"
		Classes="sheet"
		Width="460"
		HorizontalAlignment="Center"
		VerticalAlignment="Center"
		IsVisible="{Binding IsEnhancementsPanelVisible}"
	>
		<StackPanel Spacing="0" XYFocus.NavigationModes="Enabled">
			<TextBlock Classes="title3" Text="{l:Translate lblEnhancementsPanelTitle}" Margin="0 4 0 14" />
			<Border Classes="inset">
				<StackPanel>
				<Border Classes="switch-row">
					<CheckBox Name="EnhancementsModernCheckBox" Classes="switch" Content="{l:Translate chkEnhancementsModernInstruments}" IsChecked="{Binding EnhModernInstruments, Mode=TwoWay}" />
				</Border>
				<Border Classes="switch-row">
					<Panel>
						<CheckBox Name="EnhancementsBorderCheckBox" Classes="switch" Classes.subtitled="{Binding !LayerChangeKeepsPlace}" Content="{l:Translate chkEnhancementsBorder}" IsChecked="{Binding EnhBorder, Mode=TwoWay}" />
						<TextBlock Classes="row-subtitle" Text="{l:Translate lblEnhancementsAppliesOnReload}" IsVisible="{Binding !LayerChangeKeepsPlace}" />
					</Panel>
				</Border>
				<Border Classes="switch-row">
					<CheckBox Name="EnhancementsWidescreenCheckBox" Classes="switch" Content="{l:Translate chkEnhancementsWideScrn}" IsChecked="{Binding EnhWidescreen, Mode=TwoWay}" />
				</Border>
				<Border Classes="switch-row">
					<Panel>
						<CheckBox Name="EnhancementsOverclockCheckBox" Classes="switch" Classes.subtitled="{Binding !IsOverclockSupported}" Content="{l:Translate chkEnhancementsOverclock}" IsChecked="{Binding EnhOverclock, Mode=TwoWay}" IsEnabled="{Binding IsOverclockSupported}" />
						<TextBlock Name="EnhancementsOverclockReason" Classes="row-subtitle" Text="{Binding EnhOverclockReason}" IsVisible="{Binding !IsOverclockSupported}" />
					</Panel>
				</Border>
				<Button Name="EnhancementsPackButton" Classes="row" Click="OnPack">
					<DockPanel>
						<PathIcon Classes="chevron" DockPanel.Dock="Right" />
						<TextBlock Classes="title" Text="{Binding EnhPackRowText}" />
					</DockPanel>
				</Button>
				</StackPanel>
			</Border>
			<TextBlock Classes="subhead secondary" Text="{l:Translate lblEnhancementsLookHint}" Margin="2 18 0 20" />
			<Button Name="EnhancementsApplyButton" Classes="primary regular" Content="{Binding EnhancementsApplyText}" HorizontalAlignment="Right" Click="OnApply" />
		</StackPanel>
	</Border>
</UserControl>
