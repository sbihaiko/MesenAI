<UserControl xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:l="using:Mesen.Localization"
	xmlns:vm="using:Mesen.ViewModels"
	mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="640"
	x:Class="Mesen.Views.PlayBiosSheetView"
	x:DataType="vm:PlayBiosSheetViewModel"
>
	<!--G.5 (PRD Part B §13.5.2 W-P13): a game needs a BIOS file. Rule 2: drop
	zone, Cancel, Choose File… = 3. The whole dimmed area takes a drop, so a
	file dropped anywhere while the sheet is up lands here, never as a ROM.-->
	<!--ADR-0249 (W-P13): the light sheet on the dimmed home - grey lock badge,
	title, body, the drop zone, the orange wrong-file line, Cancel and Choose
	File….-->
	<Panel Name="BiosSheetBackdrop" Classes="scrim" DragDrop.AllowDrop="True">
		<Border Name="BiosSheet" Classes="sheet" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center">
			<StackPanel Spacing="0" XYFocus.NavigationModes="Enabled">
				<DockPanel Margin="0 0 0 14">
					<Border Classes="badge xlarge" Background="{StaticResource PlayerGrayBrush}" DockPanel.Dock="Left" Margin="0 0 12 0">
						<PathIcon Data="{StaticResource PlayerIconLock}" />
					</Border>
					<TextBlock Classes="sheet-heading" Text="{l:Translate lblBiosSheetTitle}" VerticalAlignment="Center" TextWrapping="Wrap" />
				</DockPanel>
				<TextBlock Name="BiosSheetBody" Classes="paragraph" Text="{Binding Body}" TextWrapping="Wrap" Margin="0 0 0 10" />
				<Button Name="BiosSheetDropZone" Classes="drop-zone" Click="OnChooseFile">
					<StackPanel Spacing="4" HorizontalAlignment="Center">
						<PathIcon Classes="drop-icon" Margin="0 0 0 6" />
						<TextBlock Name="BiosSheetDropTitle" Classes="drop-title" Text="{Binding DropTitle}" />
						<TextBlock Classes="drop-hint" Text="{Binding DropHint}" />
					</StackPanel>
				</Button>
				<!--W-X2: only after a wrong file - the shared in-place banner.-->
				<Border Name="BiosSheetError" Classes="banner warning" Margin="0 12 0 0" IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
					<DockPanel>
						<PathIcon Classes="banner-icon" DockPanel.Dock="Left" Data="{StaticResource PlayerIconWarning}" Width="16" Height="16" />
						<TextBlock Classes="banner-text" Text="{Binding ErrorText}" TextWrapping="Wrap" VerticalAlignment="Center" />
					</DockPanel>
				</Border>
				<!--W-X1: an unknown dump confirms once, in place (the shared banner).-->
				<Border Name="BiosSheetConfirm" Classes="banner warning" Margin="0 12 0 0" IsVisible="{Binding IsConfirmingUnknown}">
					<DockPanel>
						<PathIcon Classes="banner-icon" DockPanel.Dock="Left" Data="{StaticResource PlayerIconWarning}" Width="16" Height="16" />
						<StackPanel Classes="banner-actions" DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
							<Button Name="BiosSheetChooseAnother" Classes="secondary" Content="{l:Translate btnBiosSheetChooseAnother}" Click="OnRejectUnknown" />
							<Button Name="BiosSheetUseIt" Classes="primary" Content="{l:Translate btnBiosSheetUseIt}" Click="OnAcceptUnknown" />
						</StackPanel>
						<TextBlock Classes="banner-text" Text="{l:Translate lblBiosSheetUnknown}" TextWrapping="Wrap" VerticalAlignment="Center" />
					</DockPanel>
				</Border>
				<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0 34 0 0">
					<Button Name="BiosSheetCancel" Classes="secondary regular" Content="{l:Translate btnBiosSheetCancel}" Click="OnCancel" />
					<Button Name="BiosSheetChooseFile" Classes="primary regular" Content="{l:Translate btnBiosSheetChooseFile}" Click="OnChooseFile" />
				</StackPanel>
			</StackPanel>
		</Border>
	</Panel>
</UserControl>
