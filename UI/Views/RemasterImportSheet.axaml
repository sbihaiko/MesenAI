<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:Mesen.ViewModels"
	xmlns:l="using:Mesen.Localization"
	mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="260"
	x:DataType="vm:RemasterWorkspaceViewModel"
	x:Class="Mesen.Views.RemasterImportSheet"
	IsVisible="{Binding IsImportSheetVisible}"
>
	<!--G.7 (PRD Part B §13.5.3 W-R6, ADR-0198): "This is a finished pack".
	Asks once, in place (rule 7): Cancel / Make editable = 2 elements. While
	mep_import runs, the sheet shows it with Stop; a refusal lists one plain
	sentence per rule with Show line, and no Make editable. Esc closes it.-->
	<Border Name="RemasterImportCard" Background="#262626" CornerRadius="8" Padding="16" MaxWidth="560" HorizontalAlignment="Left">
		<StackPanel Spacing="10">
			<TextBlock Text="{l:Translate lblFinishedPackTitle}" FontSize="16" FontWeight="Bold" />

			<StackPanel Spacing="10" IsVisible="{Binding IsImportAsking}">
				<TextBlock Text="{l:Translate lblFinishedPackBody}" />
				<TextBlock Name="RemasterImportPatchedWarning" Text="{l:Translate lblFinishedPackPatched}" Foreground="#FFD27A" IsVisible="{Binding IsImportPatched}" />
				<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
					<Button Name="RemasterImportCancelButton" Content="{l:Translate btnImportCancel}" Click="OnCancel" />
					<StackPanel Spacing="2" MaxWidth="240">
						<Button Name="RemasterMakeEditableButton" Content="{l:Translate btnMakeEditable}" Classes="accent" IsEnabled="{Binding MakeEditable.IsEnabled}" Click="OnMakeEditable" />
						<TextBlock Name="RemasterMakeEditableReason" Classes="reason" Text="{Binding MakeEditable.Reason}" IsVisible="{Binding MakeEditable.HasReason}" />
					</StackPanel>
				</StackPanel>
			</StackPanel>

			<DockPanel IsVisible="{Binding IsImportRunning}">
				<Button Name="RemasterImportStopButton" DockPanel.Dock="Right" Content="{l:Translate btnImportStop}" Click="OnCancel" />
				<StackPanel Spacing="6">
					<TextBlock Name="RemasterImportRunningText" Text="{l:Translate lblImportRunning}" />
					<ProgressBar IsIndeterminate="True" />
				</StackPanel>
			</DockPanel>

			<StackPanel Spacing="8" IsVisible="{Binding IsImportRefused}">
				<TextBlock Text="{l:Translate lblImportRefused}" />
				<ItemsControl Name="RemasterImportRefusalList" ItemsSource="{Binding ImportRefusals}">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:RemasterRefusalRow">
							<StackPanel Spacing="4">
								<DockPanel>
									<ToggleButton Name="ShowLine" DockPanel.Dock="Right" Content="{l:Translate btnShowLine}" IsVisible="{Binding HasLine}" />
									<StackPanel Spacing="2">
										<TextBlock Classes="refusal" Text="{Binding Sentence}" />
										<TextBlock Classes="reason" Text="{Binding Where}" IsVisible="{Binding Where, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
									</StackPanel>
								</DockPanel>
								<TextBlock Classes="cited" Text="{Binding CitedLine}" FontFamily="monospace" Opacity="0.8" IsVisible="{Binding #ShowLine.IsChecked}" />
							</StackPanel>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
				<Button Name="RemasterImportCloseButton" Content="{l:Translate btnImportClose}" HorizontalAlignment="Right" Click="OnCancel" />
			</StackPanel>
		</StackPanel>
	</Border>
</UserControl>
