<UserControl xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:l="using:Mesen.Localization"
	xmlns:c="using:Mesen.Controls"
	xmlns:vm="using:Mesen.ViewModels"
	mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="560"
	x:Class="Mesen.Views.PlayHomeView"
	x:DataType="vm:RecentGamesViewModel"
>
	<!--G.2 (PRD Part B §8, ADR-0241, §13.5.2): the Play home. Which of the three
	panels shows is decided by RecentGamesViewModel through the host-free
	UI/Logic/PlayHome; this view only binds it. A ROM dropped anywhere on the
	window still loads it (MainWindow.OnDrop).-->
	<Panel>
		<!--ADR-0249: the Player home sits on the theme's light page (WINBG);
		the classic grid below keeps the host's dark background.-->
		<Border Name="PlayHomeBackground" Classes="page" IsVisible="{Binding !ShowPlainGrid}" />

		<!--W-P1, true first run (no recents): one primary action (rule 2: 1
		control), and a sentence that says what happens next (rule 10).-->
		<StackPanel Name="PlayHomeFirstRun" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 0 0 70" IsVisible="{Binding ShowFirstRunHome}">
			<Border Name="PlayHomeFirstRunBadge" Classes="badge large" HorizontalAlignment="Center">
				<PathIcon Data="{StaticResource PlayerIconPlay}" />
			</Border>
			<TextBlock Name="PlayHomeDropTitle" Classes="large-title" Text="{l:Translate lblPlayHomeDropTitle}" HorizontalAlignment="Center" Margin="0 32 0 0" />
			<TextBlock Classes="headline secondary" FontWeight="Normal" Text="{l:Translate lblPlayHomeDropSubtitle}" HorizontalAlignment="Center" Margin="0 8 0 0" />
			<Button Name="PlayHomeOpenRomPrimary" Classes="primary large" Width="220" Content="{l:Translate btnPlayHomeOpenRom}" HorizontalAlignment="Center" Margin="0 26 0 0" Click="OnOpenRom" />
			<TextBlock Name="PlayHomeOrientation" Classes="secondary" Text="{Binding FirstRunOrientation}" IsVisible="{Binding FirstRunOrientation.Length}" TextWrapping="Wrap" LineHeight="18" Margin="0 46 0 0" />
		</StackPanel>

		<!--W-P2, with recents: Continue is the primary action; Open a ROM… the
		second control; the tiles are list rows (rule 2: 2 + tiles). Gamepad:
		the two buttons and the grid are focusable (XY focus), and the grid keeps
		today's StateGrid arrow navigation.-->
		<DockPanel Name="PlayHomeWithRecents" Classes.favorites="{Binding ShowFavorites}" Margin="40 26 40 16" IsVisible="{Binding ShowRecentsHome}" XYFocus.NavigationModes="Enabled">
			<!--#1110 (W-P20): the shelf takes a row, so the hero and both tile rows
			tighten to the wireframe's proportions and the Recent row stays on screen
			above the action bar.-->
			<DockPanel.Styles>
				<Style Selector="Border#PlayHomeContinueCard">
					<Setter Property="Height" Value="160" />
					<Setter Property="Margin" Value="0 0 0 34" />
				</Style>
				<Style Selector="Panel#PlayHomeRecentGrid">
					<Setter Property="Height" Value="172" />
				</Style>
				<Style Selector="DockPanel.favorites Border#PlayHomeContinueCard">
					<Setter Property="Height" Value="120" />
					<Setter Property="Margin" Value="0 0 0 22" />
				</Style>
				<Style Selector="DockPanel.favorites Panel#PlayHomeFavoritesGrid">
					<Setter Property="Height" Value="164" />
				</Style>
				<Style Selector="DockPanel.favorites Panel#PlayHomeRecentGrid">
					<Setter Property="Height" Value="164" />
				</Style>
			</DockPanel.Styles>
			<DockPanel DockPanel.Dock="Top" Margin="0 0 0 14">
				<Button Name="PlayHomeOpenRomSecondary" AutomationProperties.AutomationId="play.home.open-rom" Classes="secondary" DockPanel.Dock="Right" VerticalAlignment="Top" Click="OnOpenRom">
					<StackPanel Orientation="Horizontal">
						<PathIcon Classes="leading" Data="{StaticResource PlayerIconFolder}" />
						<TextBlock Text="{l:Translate btnPlayHomeOpenRom}" />
					</StackPanel>
				</Button>
				<TextBlock Classes="title1" Text="{l:Translate lblPlayHomeContinueHeader}" VerticalAlignment="Bottom" />
			</DockPanel>
			<!--W-P2's hero: a game-picture panel and the Continue block. The
			picture is the recent entry's screenshot (the .rgd's Screenshot.png),
			a placeholder gradient when it has none.-->
			<Border Name="PlayHomeContinueCard" Classes="card hero" DockPanel.Dock="Top" ClipToBounds="True">
				<DockPanel>
					<Border Name="PlayHomeContinueArt" DockPanel.Dock="Left" Width="260" CornerRadius="16 0 0 16">
						<Border.Background>
							<LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
								<GradientStop Offset="0" Color="#182048" />
								<GradientStop Offset="1" Color="#3C6EAA" />
							</LinearGradientBrush>
						</Border.Background>
						<Panel>
							<PathIcon Data="{StaticResource PlayerIconPlay}" Width="34" Height="34" Foreground="#B3FFFFFF" IsVisible="{Binding !HasContinuePreview}" />
							<!--W-P2: the recent entry's own screenshot fills the panel.-->
							<Image Name="PlayHomeContinuePreview" Source="{Binding ContinuePreview}" Stretch="UniformToFill" IsVisible="{Binding HasContinuePreview}" RenderOptions.BitmapInterpolationMode="LowQuality" />
						</Panel>
					</Border>
					<StackPanel Margin="28 0 24 0" VerticalAlignment="Center">
						<TextBlock Name="PlayHomeContinueTitle" Classes="title2" Text="{Binding ContinueTitle}" TextTrimming="CharacterEllipsis" />
						<TextBlock Name="PlayHomeContinueSubtitle" Classes="secondary" Text="{Binding ContinueSubtitle}" IsVisible="{Binding ContinueSubtitle.Length}" Margin="0 6 0 0" />
						<!--W-P2: a drawn play icon leads the label (no ▶ glyph in the string).-->
						<Button Name="PlayHomeContinueButton" AutomationProperties.AutomationId="play.home.continue" Classes="primary medium" HorizontalAlignment="Left" Margin="0 18 0 0" Click="OnContinue">
							<StackPanel Orientation="Horizontal">
								<PathIcon Classes="leading" Data="{StaticResource PlayerIconPlay}" />
								<TextBlock Text="{l:Translate btnPlayHomeContinue}" />
							</StackPanel>
						</Button>
					</StackPanel>
				</DockPanel>
			</Border>
			<!--#1110 (ADR-0268, W-P20): the Favorites shelf, between Continue and Recent;
			not drawn while the list has no file that exists, so Home is W-P2 as today.-->
			<TextBlock Name="PlayHomeFavoritesHeader" DockPanel.Dock="Top" Classes="headline" Text="{l:Translate lblPlayHomeFavoritesHeader}" Margin="0 0 0 8" IsVisible="{Binding ShowFavorites}" />
			<Panel Name="PlayHomeFavoritesGrid" DockPanel.Dock="Top" IsVisible="{Binding ShowFavorites}" VerticalAlignment="Top" Margin="0 0 0 12">
				<c:StateGrid Classes="tiles" Entries="{Binding FavoriteEntries}" Title="" Mode="{Binding Mode}" />
			</Panel>
			<TextBlock DockPanel.Dock="Top" Classes="headline" Text="{l:Translate lblPlayHomeRecentHeader}" Margin="0 0 0 8" IsVisible="{Binding ShowHomeGrid}" />
			<!--StateGrid names its own root ("root", for its ElementName bindings),
			so the test handle is the Panel around it. `tiles`: one row of
			W-P2 tiles (StateGrid.Tiles) instead of the classic paged grid.-->
			<Panel Name="PlayHomeRecentGrid" IsVisible="{Binding ShowHomeGrid}" VerticalAlignment="Top">
				<c:StateGrid Classes="tiles" Entries="{Binding HomeGridEntries}" Title="" Mode="{Binding Mode}" />
			</Panel>
		</DockPanel>

		<!--G.5 (W-P14): a file that does not open - one inline alert under the
		home's content (W-X2: a sentence and the next step, never a code). W-P2's
		2 controls + Open Another… = 3; the ✕ only closes it.-->
		<!--ADR-0249 (W-P14): Border.alert - warm card, amber outline; the orange
		warning icon, the title in TEXT, the body in TEXT2, Open Another…
		(secondary, folder glyph) as its one control: opening anything (this
		button, a tile, Continue, a drop) clears the alert, so no close box.-->
		<Border Name="PlayHomeLoadAlert" Classes="alert" VerticalAlignment="Bottom" Margin="32 0 32 24" MaxWidth="900" Padding="18 12 12 14" IsVisible="{Binding IsLoadAlertVisible}">
			<DockPanel>
				<Button Name="PlayHomeOpenAnother" Classes="secondary" DockPanel.Dock="Right" VerticalAlignment="Top" Click="OnOpenAnother">
					<StackPanel Orientation="Horizontal">
						<PathIcon Classes="leading" Data="{StaticResource PlayerIconFolder}" />
						<TextBlock Text="{l:Translate btnPlayHomeOpenAnother}" />
					</StackPanel>
				</Button>
				<PathIcon Classes="warning" DockPanel.Dock="Left" Data="{StaticResource PlayerIconWarning}" Width="15" Height="15" VerticalAlignment="Top" Margin="0 6 10 0" />
				<StackPanel Spacing="3" Margin="0 4 12 0">
					<TextBlock Name="PlayHomeLoadAlertTitle" Classes="callout strong" Text="{Binding LoadAlertTitle}" TextWrapping="Wrap" />
					<TextBlock Name="PlayHomeLoadAlertBody" Classes="subhead secondary" Text="{Binding LoadAlertBody}" TextWrapping="Wrap" />
				</StackPanel>
			</DockPanel>
		</Border>

		<!--Advanced's game selection and the Save/Load state screens: the
		classic grid of every entry, unchanged by G.2.-->
		<Panel Name="PlayHomePlainGrid" IsVisible="{Binding ShowPlainGrid}">
			<!--ADR-0249: in Player mode the Save/Load state slots are a light
			sheet of tiles over the dimmed game (ShowSlotTiles); Advanced keeps
			the classic grid - no class, no background, the grid fills.-->
			<Border Classes.scrim="{Binding ShowSlotTiles}" />
			<Border Name="PlayHomeSlotSheet" Classes.sheet="{Binding ShowSlotTiles}" Classes.slot-sheet="{Binding ShowSlotTiles}">
				<c:StateGrid Classes.tiles="{Binding ShowSlotTiles}" Classes.slots="{Binding ShowSlotTiles}" Entries="{Binding GameEntries}" Title="{Binding Title}" Mode="{Binding Mode}" />
			</Border>
		</Panel>
	</Panel>
</UserControl>
