<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:Mesen.ViewModels"
	xmlns:c="using:Mesen.Controls"
	xmlns:l="using:Mesen.Localization"
	mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="380"
	VerticalAlignment="Stretch"
	HorizontalAlignment="Stretch"
	x:DataType="vm:LookConfigViewModel"
	x:Class="Mesen.Views.LookConfigView"
>
	<!-- ADR-0246 (P.13): Art, Pixels and Screen in the order they apply, each
	     with the mark of where its result goes. ADR-0249 (W-P10): three inset
	     groups under a caps label and its hint; Hold to Compare at the foot,
	     beside the window's Done. -->
	<UserControl.Styles>
		<Style Selector="ComboBox.lookChoices ComboBoxItem">
			<Setter Property="IsEnabled" Value="{Binding IsEnabled, DataType={x:Type vm:LookChoice}}" />
		</Style>
		<Style Selector="TextBlock.lookNote">
			<Setter Property="Opacity" Value="0.75" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="Margin" Value="0 3 0 0" />
		</Style>
		<Style Selector=".player TextBlock.lookNote">
			<Setter Property="Opacity" Value="1" />
		</Style>
		<Style Selector="StackPanel.lookGroupLabel">
			<Setter Property="Orientation" Value="Horizontal" />
			<Setter Property="Spacing" Value="6" />
			<Setter Property="Margin" Value="2 0 0 6" />
		</Style>
		<Style Selector="Border.lookGroup">
			<Setter Property="Margin" Value="0 0 0 16" />
		</Style>
		<Style Selector="StackPanel.lookGroupBody">
			<Setter Property="Margin" Value="16 11 16 10" />
		</Style>
		<!-- Outside the Player scope the Art row still names its action. -->
		<Style Selector=".player TextBlock.lookClassicOnly">
			<Setter Property="IsVisible" Value="False" />
		</Style>
		<!-- W-P10's caps labels and their hints are the Player sheet's; Advanced
		     keeps the classic "Art" / "Pixels" / "Screen" headers. -->
		<Style Selector="TextBlock.lookPlayerOnly">
			<Setter Property="IsVisible" Value="False" />
		</Style>
		<Style Selector=".player TextBlock.lookPlayerOnly">
			<Setter Property="IsVisible" Value="True" />
		</Style>
		<!-- The Art row's text sits after the pack badge when a pack draws the art. -->
		<Style Selector="TextBlock#txtLookArt">
			<Setter Property="Margin" Value="16 0" />
		</Style>
		<Style Selector="TextBlock#txtLookArt.art">
			<Setter Property="Margin" Value="48 0 36 0" />
		</Style>
	</UserControl.Styles>

	<DockPanel>
		<!--#1149 (ADR-0269 Decision 6, W-P10): the footer is Done's row, and W-P10
		draws the compare note in it beside Hold to Compare - which is where it
		stays wherever the row has room for it, unchanged at the ~1024x640 the
		wireframe is drawn at. At 1.5 in 512x505 the row leaves the note about
		14 px of the 271 px page, which is no room at all, so there the note
		takes the line above on the page's own width and wraps, drawn whole.
		LookFooterPanel decides which of the two, by LookFooter's host-free rule.
		Its third child is the line the note is kept at: this tab carries the
		hold-to-compare hint while Pixels or Screen has something to compare and
		the reason while it does not, and toggling either swaps one for the
		other - so the taller of the two is measured with the note, never drawn,
		and the footer keeps its height (the review of #1163, finding 3).-->
		<c:LookFooterPanel DockPanel.Dock="Bottom" Name="LookFooter" Margin="0 4 0 0">
			<Button Name="btnLookHoldToCompare" Classes="secondary regular" Content="{l:Translate btnLookHoldToCompare}" IsEnabled="{Binding CanCompare}" VerticalAlignment="Center" />
			<TextBlock Name="txtLookCompareReason" Classes="lookNote footnote tertiary" Text="{Binding CompareReason}" VerticalAlignment="Center" />
			<TextBlock Name="txtLookCompareReserve" Classes="lookNote footnote tertiary" Text="{Binding CompareNoteReserve}" TextWrapping="Wrap" Opacity="0" IsHitTestVisible="False" VerticalAlignment="Center" />
		</c:LookFooterPanel>

		<ScrollViewer AllowAutoHide="False" HorizontalScrollBarVisibility="Disabled" Padding="0 0 2 0">
			<StackPanel>
				<StackPanel Classes="lookGroupLabel">
					<TextBlock Classes="group-label lookClassicOnly" Text="{l:Translate lblLookArt}" />
					<TextBlock Name="lblLookArtHeader" Classes="group-label lookPlayerOnly" Text="{l:Translate lblPlayerLookArt}" />
					<TextBlock Name="lblLookArtHint" Classes="group-hint lookPlayerOnly" Text="{l:Translate lblLookArtHint}" />
				</StackPanel>
				<Border Name="LookArtGroup" Classes="group inset lookGroup">
					<Panel MinHeight="46">
						<Button Name="btnLookPackDetails" Classes="row" Height="46" IsVisible="{Binding HasArt}" Click="OnPackDetails" AutomationProperties.Name="{l:Translate btnLookPackDetails}">
							<DockPanel>
								<Border Classes="badge" Background="{StaticResource PlayerTintShareBrush}"><PathIcon Data="{StaticResource PlayerIconPack}" /></Border>
								<PathIcon Classes="chevron" DockPanel.Dock="Right" />
								<TextBlock Classes="lookClassicOnly" DockPanel.Dock="Right" Text="{l:Translate btnLookPackDetails}" VerticalAlignment="Center" />
								<Panel />
							</DockPanel>
						</Button>
						<TextBlock Name="txtLookArt" Classes="callout" Classes.art="{Binding HasArt}" Text="{Binding ArtText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
					</Panel>
				</Border>

				<StackPanel Classes="lookGroupLabel">
					<TextBlock Classes="group-label lookClassicOnly" Text="{l:Translate lblLookPixels}" />
					<TextBlock Classes="group-label lookPlayerOnly" Text="{l:Translate lblPlayerLookPixels}" />
					<TextBlock Classes="group-hint lookPlayerOnly" Text="{l:Translate lblLookPixelsHint}" />
				</StackPanel>
				<Border Name="LookPixelsGroup" Classes="group inset lookGroup">
					<StackPanel Classes="lookGroupBody">
						<!--#1123 (ADR-0269 Decision 6): the label keeps its own
						Auto column so a 200 px popup cannot leave it 18 px to
						draw 70 px of text in at 1.5 in 512x505; the star gives
						the popup the rest: its cap wherever there is room for it,
						less where there is not, carried by the column the popup
						stretches into - `Stretch` is written out because a
						ComboBox is Left by default and would be arranged at its
						own DesiredSize (PlayerAudioSettingsView carries the
						reasons in full).-->
						<Grid Classes="look-row">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="1000*" MaxWidth="200" />
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Classes="callout" Classes.tertiary="{Binding !PixelsEnabled}" Text="{l:Translate lblLookSmoothing}" VerticalAlignment="Center" />
							<ComboBox
								Grid.Column="2"
								Name="cboLookPixels"
								HorizontalAlignment="Stretch"
								Classes="lookChoices popup"
								ItemsSource="{Binding PixelsChoices}"
								SelectedItem="{Binding SelectedPixels, Mode=TwoWay}"
								IsEnabled="{Binding PixelsEnabled}"
							>
								<ComboBox.ItemTemplate>
									<DataTemplate DataType="vm:LookChoice">
										<TextBlock Text="{Binding Label}" />
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
						</Grid>
						<TextBlock Name="txtLookPixelsReason" Classes="lookNote reason" Text="{Binding PixelsReason}" IsVisible="{Binding PixelsReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Margin="0 10 0 0" />
						<TextBlock Name="txtLookPixelsMark" Classes="lookNote footnote secondary" Text="{Binding PixelsMark}" Margin="0 6 0 0" />
					</StackPanel>
				</Border>

				<StackPanel Classes="lookGroupLabel">
					<TextBlock Classes="group-label lookClassicOnly" Text="{l:Translate lblLookScreen}" />
					<TextBlock Classes="group-label lookPlayerOnly" Text="{l:Translate lblPlayerLookScreen}" />
					<TextBlock Classes="group-hint lookPlayerOnly" Text="{l:Translate lblLookScreenHint}" />
				</StackPanel>
				<Border Name="LookScreenGroup" Classes="group inset lookGroup">
					<StackPanel Classes="lookGroupBody">
						<!--#1123 (ADR-0269 Decision 6): Adjust keeps its Auto column
						and the label its own, so neither the label nor the button
						the 200 px popup used to push out of the row is drawn past
						its room at 1.5 in 512x505. The popup's cap is carried by
						its own column (the reasons are on the Pixels row above),
						so where the row has room past 200 the leftover goes to the
						star before it - the label's side - and the popup sits
						flush against Adjust's own margin, exactly its column's
						width, rather than floating between the two.-->
						<Grid Classes="look-row">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="1000*" MaxWidth="200" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Classes="callout" Text="{l:Translate lblLookEffect}" VerticalAlignment="Center" />
							<ComboBox
								Grid.Column="2"
								Name="cboLookScreen"
								HorizontalAlignment="Stretch"
								Classes="lookChoices popup"
								ItemsSource="{Binding ScreenChoices}"
								SelectedItem="{Binding SelectedScreen, Mode=TwoWay}"
								VerticalAlignment="Center"
							>
								<ComboBox.ItemTemplate>
									<DataTemplate DataType="vm:LookChoice">
										<TextBlock Text="{Binding Label}" />
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
							<Button Grid.Column="3" Name="btnLookAdjust" Classes="secondary" Content="{l:Translate btnLookAdjust}" IsEnabled="{Binding CanAdjust}" Margin="8 0 0 0" Click="OnAdjust" VerticalAlignment="Center" />
						</Grid>
						<TextBlock Name="txtLookScreenNote" Classes="lookNote reason" Text="{Binding ScreenNote}" IsVisible="{Binding ScreenNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Margin="0 10 0 0" />
						<TextBlock Name="txtLookScreenMark" Classes="lookNote footnote secondary" Text="{Binding ScreenMark}" Margin="0 6 0 0" />
					</StackPanel>
				</Border>
			</StackPanel>
		</ScrollViewer>
	</DockPanel>
</UserControl>
