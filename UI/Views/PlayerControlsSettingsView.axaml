<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:Mesen.ViewModels"
	xmlns:l="using:Mesen.Localization"
	mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="160"
	x:DataType="vm:PlayerControlsSettingsViewModel"
	x:Class="Mesen.Views.PlayerControlsSettingsView"
>
	<!--#1112: a fourth row, Menu tick, only while the pad in hand is aimable.
	G.4 (W-P8): Settings › Controls - three rows in Display's pattern: which
	pads are connected, Rumble and the stick deadzone. Per-console controller
	types and the button mapping are "More in Options…".
	#1123 (ADR-0269 Decision 6): the rows are the Auto/star Grid Display and
	Audio use - see PlayerAudioSettingsView for why a right-docked fixed-width
	control cannot share a 220 px row with its label.-->
	<Border Name="ControlsSettingsGroup" Classes="group inset" VerticalAlignment="Top">
		<StackPanel XYFocus.NavigationModes="Enabled">
			<Grid Classes="setting-row" ColumnDefinitions="Auto,*">
				<TextBlock Grid.Column="0" Classes="callout" Text="{l:Translate lblControlsControllers}" VerticalAlignment="Center" />
				<!--#1123: what is connected is host data and can be any length; at
				1.5 in 512x505 the star column is 148 px and "No controller
				connected" needs 156, so the value takes a second line (right
				aligned) instead of being drawn past the box it was given.-->
				<TextBlock Grid.Column="1" Name="txtControlsPads" Classes="callout secondary" Text="{Binding ControllersText}" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center" />
			</Grid>
			<Separator Classes="row-hairline" />
			<Grid Classes="setting-row" ColumnDefinitions="Auto,*,Auto">
				<TextBlock Grid.Column="0" Classes="callout" Text="{l:Translate lblControlsRumble}" VerticalAlignment="Center" />
				<Slider Grid.Column="1" Name="sldControlsRumble" Width="150" Minimum="0" Maximum="10" Value="{Binding Rumble}" HorizontalAlignment="Right" VerticalAlignment="Center" />
				<TextBlock Grid.Column="2" Name="txtControlsRumble" Classes="callout" Width="34" TextAlignment="Right" Text="{Binding RumbleText}" VerticalAlignment="Center" />
			</Grid>
			<Separator Classes="row-hairline" />
			<Grid Classes="setting-row" ColumnDefinitions="Auto,*,Auto">
				<TextBlock Grid.Column="0" Classes="callout" Text="{l:Translate lblControlsDeadzone}" VerticalAlignment="Center" />
				<Slider Grid.Column="1" Name="sldControlsDeadzone" Width="150" Minimum="0" Maximum="4" Value="{Binding Deadzone}" HorizontalAlignment="Right" VerticalAlignment="Center" />
				<TextBlock Grid.Column="2" Name="txtControlsDeadzone" Classes="callout" Width="34" TextAlignment="Right" Text="{Binding Deadzone, StringFormat={}{0:0}}" VerticalAlignment="Center" />
			</Grid>
			<Separator Classes="row-hairline" IsVisible="{Binding MenuTickAvailable}" />
			<Grid Classes="setting-row" ColumnDefinitions="Auto,*,Auto,Auto" IsVisible="{Binding MenuTickAvailable}">
				<TextBlock Grid.Column="0" Classes="callout" Text="{l:Translate lblControlsMenuTick}" VerticalAlignment="Center" />
				<TextBlock Grid.Column="2" Name="txtControlsMenuTickReason" Classes="callout secondary" Margin="0,0,10,0" Text="{l:Translate lblControlsMenuTickRumbleOff}" IsVisible="{Binding MenuTickRumbleOff}" HorizontalAlignment="Right" VerticalAlignment="Center" />
				<ToggleSwitch Grid.Column="3" Name="chkControlsMenuTick" IsChecked="{Binding Config.MenuTick}" IsEnabled="{Binding MenuTickEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center" />
			</Grid>
		</StackPanel>
	</Border>
</UserControl>
