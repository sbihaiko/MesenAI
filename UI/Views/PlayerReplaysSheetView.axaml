<UserControl xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:l="using:Mesen.Localization"
	xmlns:vm="using:Mesen.ViewModels"
	mc:Ignorable="d"
	x:Class="Mesen.Views.PlayerReplaysSheetView"
	x:DataType="vm:PlayerReplaysSheetViewModel"
>
	<!--R.2 (ADR-0205 §7): W-P4 › Save states › Shared replays - the community
	replays recorded on this exact copy of the game (ROM SHA-1, never the
	title), most-👍-first. Each row: title, length, a cheats badge (§7), the
	vote count that opens the issue (↗), and Watch, which asks once in place
	because playing restarts the game. Every rule is in the host-free
	UI/Logic (CommunityReplayCatalog, ReplayWatch); this view only binds it.-->
	<!--ADR-0249: no render of its own - W-P11's sheet and inset list: each
	replay is a row (title, then length · cheats badge · 👍 count) with Watch
	on its right; the status and notice lines, then Done.-->
	<Border
		Name="PlayerReplaysSheet"
		Classes="sheet"
		Width="500"
		HorizontalAlignment="Center"
		VerticalAlignment="Center"
		IsVisible="{Binding IsVisible}"
	>
		<StackPanel Spacing="0">
			<TextBlock Classes="title3" Text="{l:Translate lblReplaysTitle}" Margin="0 4 0 14" />

			<!--The inset is drawn behind the list, not around it, so the list
			stays in the visual tree when there are no rows.-->
			<Panel>
				<Border Classes="inset" IsVisible="{Binding Rows.Count}" />
				<ScrollViewer MaxHeight="320" Margin="1" HorizontalScrollBarVisibility="Disabled">
					<ItemsControl Name="ReplaysList" ItemsSource="{Binding Rows}" XYFocus.NavigationModes="Enabled">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="vm:PlayerReplayRow">
								<Border Classes="switch-row tall">
									<DockPanel Margin="0 8 16 8">
										<Button Name="ReplaysWatchButton" Classes="secondary" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12 0 0 0" Content="{Binding WatchLabel}" IsEnabled="{Binding CanWatch}" Click="OnWatch" />
										<StackPanel Spacing="1" VerticalAlignment="Center">
											<TextBlock Classes="callout" Text="{Binding Title}" TextWrapping="Wrap" />
											<StackPanel Orientation="Horizontal" Spacing="8">
												<TextBlock Classes="footnote secondary" VerticalAlignment="Center" Text="{Binding Length}" />
												<TextBlock Name="ReplaysCheatBadge" Classes="footnote cheat-badge" VerticalAlignment="Center" Text="{Binding CheatBadge}" IsVisible="{Binding HasCheats}" />
												<Button Name="ReplaysVotesButton" Classes="plain small" Content="{Binding VotesLabel}" Click="OnOpenIssue" />
											</StackPanel>
										</StackPanel>
									</DockPanel>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</Panel>

			<TextBlock Name="ReplaysStatusLine" Classes="subhead secondary" Text="{Binding StatusLine}" TextWrapping="Wrap" Margin="2 16 0 0" />
			<!--Every wait moves (2026-10-03): the catalog fetch, then Watch's download.-->
			<ProgressBar Name="ReplaysLoadingBar" IsIndeterminate="True" Width="200" HorizontalAlignment="Left" Margin="2 8 0 0" IsVisible="{Binding IsLoading}" />
			<StackPanel Name="ReplaysDownloadWait" Spacing="8" Margin="2 12 0 0" IsVisible="{Binding IsBusy}">
				<TextBlock Classes="subhead secondary" Text="{Binding DownloadingText}" />
				<ProgressBar IsIndeterminate="True" Width="200" HorizontalAlignment="Left" />
			</StackPanel>
			<TextBlock Name="ReplaysNoticeLine" Classes="replay-note" TextWrapping="Wrap" Margin="2 8 0 0" Text="{Binding NoticeLine}" />
			<Button Name="ReplaysDoneButton" Classes="primary regular" HorizontalAlignment="Right" Margin="0 24 0 0" Content="{l:Translate btnReplaysDone}" Click="OnDone" />
		</StackPanel>
	</Border>
</UserControl>
