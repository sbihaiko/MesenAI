<UserControl xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:l="using:Mesen.Localization"
	xmlns:vm="using:Mesen.ViewModels"
	mc:Ignorable="d"
	x:Class="Mesen.Views.PlayerReplaysSheetView"
	x:DataType="vm:PlayerReplaysSheetViewModel"
>
	<!--R.2 (ADR-0205 §7): W-P4 › Save states › Shared replays - the community
	replays recorded on this exact copy of the game (ROM SHA-1, never the
	title), most-👍-first. Each row: title, length, a cheats badge (§7), the
	vote count that opens the issue (↗), and Watch, which asks once in place
	because playing restarts the game. Every rule is in the host-free
	UI/Logic (CommunityReplayCatalog, ReplayWatch); this view only binds it.-->
	<Border
		Name="PlayerReplaysSheet"
		Background="#DD000000"
		HorizontalAlignment="Center"
		VerticalAlignment="Center"
		Padding="24"
		IsVisible="{Binding IsVisible}"
	>
		<StackPanel Spacing="8" MinWidth="340" MaxWidth="520">
			<TextBlock Text="{l:Translate lblReplaysTitle}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" />

			<ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Disabled">
				<ItemsControl Name="ReplaysList" ItemsSource="{Binding Rows}" XYFocus.NavigationModes="Enabled">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Spacing="6" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:PlayerReplayRow">
							<DockPanel>
								<Button Name="ReplaysWatchButton" DockPanel.Dock="Right" VerticalAlignment="Center" Content="{Binding WatchLabel}" IsEnabled="{Binding CanWatch}" Click="OnWatch" />
								<StackPanel Spacing="0">
									<TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
									<StackPanel Orientation="Horizontal" Spacing="6">
										<TextBlock FontSize="11" Opacity="0.7" VerticalAlignment="Center" Text="{Binding Length}" />
										<TextBlock Name="ReplaysCheatBadge" FontSize="11" Foreground="#FFD080" VerticalAlignment="Center" Text="{Binding CheatBadge}" IsVisible="{Binding HasCheats}" />
										<Button Name="ReplaysVotesButton" FontSize="11" Padding="4 0" Content="{Binding VotesLabel}" Click="OnOpenIssue" />
									</StackPanel>
								</StackPanel>
							</DockPanel>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>

			<TextBlock Name="ReplaysStatusLine" Text="{Binding StatusLine}" TextWrapping="Wrap" />
			<TextBlock Name="ReplaysNoticeLine" FontSize="11" Opacity="0.8" TextWrapping="Wrap" Text="{Binding NoticeLine}" />
			<Button Name="ReplaysDoneButton" HorizontalAlignment="Right" Content="{l:Translate btnReplaysDone}" Click="OnDone" />
		</StackPanel>
	</Border>
</UserControl>
