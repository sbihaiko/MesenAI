<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" d:DesignWidth="100" d:DesignHeight="100"
	xmlns:c="using:Mesen.Controls"
	x:Name="root"
	x:Class="Mesen.Controls.StateGridEntry"
>
	<UserControl.Resources>
		<Color x:Key="ButtonBorderBrushDisabled">Gray</Color>
		<Color x:Key="ButtonBackgroundDisabled">Black</Color>
		<Color x:Key="ButtonBorderBrushPointerOver">#00C0FF</Color>
	</UserControl.Resources>
	<UserControl.Styles>
		<!--The classic look; a `tiles` entry (ADR-0249, Player home) takes its
		look from UI/Styles/PlayerTheme.axaml instead.-->
		<Style Selector="c|StateGridEntry:not(.tiles)">
			<Setter Property="HorizontalAlignment" Value="Stretch" />
		</Style>
		<Style Selector="c|StateGridEntry:not(.tiles) DockPanel">
			<Setter Property="Margin" Value="2 2 2 7" />
		</Style>
		<Style Selector="c|StateGridEntry:not(.tiles) TextBlock">
			<Setter Property="Foreground" Value="White" />
			<Setter Property="TextAlignment" Value="Center" />
		</Style>
		<Style Selector="c|StateGridEntry:not(.tiles) TextBlock:disabled">
			<Setter Property="Foreground" Value="Gray" />
		</Style>
		<Style Selector="c|StateGridEntry:not(.tiles) Button">
			<Setter Property="BorderThickness" Value="2" />
			<Setter Property="HorizontalAlignment" Value="Center" />
			<Setter Property="BorderBrush" Value="SlateGray" />
			<Setter Property="Background" Value="Black" />
		</Style>
		<Style Selector="c|StateGridEntry:not(.tiles) Button.activeEntry">
			<Setter Property="BorderBrush" Value="#0088E7" />
			<Setter Property="Background" Value="#FF3A3A3A" />
		</Style>
	</UserControl.Styles>
	
	<DockPanel>
		<TextBlock
			Classes="subtitle"
			DockPanel.Dock="Bottom"
			Text="{Binding SubTitle, ElementName=root}"
			TextWrapping="Wrap"
			IsEnabled="{Binding Enabled, ElementName=root}"
		/>
		<TextBlock
			Classes="title"
			DockPanel.Dock="Bottom"
			Text="{Binding Title, ElementName=root}"
			TextWrapping="NoWrap"
			TextTrimming="CharacterEllipsis"
			IsEnabled="{Binding Enabled, ElementName=root}"
		/>
		<Button
			Name="TileButton"
			Classes.activeEntry="{Binding IsActiveEntry, ElementName=root}"
			Click="OnImageClick"
			IsEnabled="{Binding Enabled, ElementName=root}"
			VerticalAlignment="Stretch"
			Padding="0"
		>
			<c:ImageAspectRatio
				Source="{Binding Image, ElementName=root}"
				AspectRatio="{Binding AspectRatio, ElementName=root}"
				RenderOptions.BitmapInterpolationMode="LowQuality"
				Stretch="Fill"
				StretchDirection="Both"
				VerticalAlignment="Center"
			/>
		</Button>
	</DockPanel>
</UserControl>