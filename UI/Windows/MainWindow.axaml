<Window xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:m="clr-namespace:Mesen"
	xmlns:c="using:Mesen.Controls"
	xmlns:v="using:Mesen.Views"
	xmlns:l="using:Mesen.Localization"
	xmlns:vm="using:Mesen.ViewModels"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:lg="using:Mesen.Logic"
	mc:Ignorable="d" d:DesignWidth="512" d:DesignHeight="505"
	x:Class="Mesen.Windows.MainWindow"
	Width="512" Height="505"
	MinWidth="160" MinHeight="144"
	DragDrop.AllowDrop="True"
	x:DataType="vm:MainWindowViewModel"
	Topmost="{Binding Config.Preferences.AlwaysOnTop}"
	Title="{Binding WindowTitle}"
>

	<Design.DataContext>
		<vm:MainWindowViewModel />
	</Design.DataContext>

	<Window.DataTemplates>
		<DataTemplate DataType="{x:Type vm:AudioPlayerViewModel}">
			<v:AudioPlayerView />
		</DataTemplate>
		<DataTemplate DataType="{x:Type vm:RecentGamesViewModel}">
			<!--G.2 (PRD Part B §13.5.2): the Play home (W-P1 first run, W-P2 with
			recents) and, unchanged, the classic grid for Advanced's game selection
			and the Save/Load state screens.-->
			<v:PlayHomeView />
		</DataTemplate>
	</Window.DataTemplates>
	
	<Window.Styles>
		<!--ADR-0249: the status line's classic look; PlayerStatusLine below is
		its Player look (W-S1: WINBG, a hairline, a 7 px dot, 11.5 px TEXT2).-->
		<Style Selector="Border#ShellStatusLine">
			<Setter Property="Background" Value="{DynamicResource MesenMenuBackground}" />
		</Style>
		<Style Selector="Border#ShellStatusLine.player">
			<Setter Property="Background" Value="{StaticResource PlayerWindowBackgroundBrush}" />
			<Setter Property="BorderBrush" Value="{StaticResource PlayerStatusSeparatorBrush}" />
			<Setter Property="BorderThickness" Value="0 1 0 0" />
		</Style>
		<Style Selector="Border#ShellStatusLine.player TextBlock#ShellStatusText">
			<Setter Property="FontSize" Value="{StaticResource PlayerFontFootnote}" />
			<Setter Property="Foreground" Value="{StaticResource PlayerText2Brush}" />
		</Style>
		<Style Selector="Border#ShellStatusLine.player TextBlock#ShellStatusDot">
			<Setter Property="FontSize" Value="9" />
			<Setter Property="Opacity" Value="1" />
			<Setter Property="Foreground" Value="{StaticResource PlayerText3Brush}" />
		</Style>
		<Style Selector="Border#ShellStatusLine.player TextBlock#ShellStatusDot.live">
			<Setter Property="Foreground" Value="{StaticResource PlayerTintShareBrush}" />
		</Style>
	</Window.Styles>

	<DockPanel>
		<!--G.1, ADR-0250: the classic menu bar is the Classic door's (MainMenuView
		without its duplicates, plus Workspace ▸); the task doors hide it, through
		PlayerChrome. Classic has no shell bar and keeps the plain title bar.-->
		<Panel DockPanel.Dock="Top" IsVisible="{Binding IsMenuVisible}">
			<Panel DataContext="{Binding MainMenu}">
				<v:MainMenuView Name="MainMenu" />
			</Panel>
		</Panel>

		<!--G.1 (W-S1): the shell bar - active profile + Tools ⋯. Hidden while a
		game runs unpaused in Play (WorkspaceShell.IsBarVisible).-->
		<v:WorkspaceShellBar Name="ShellBar" DockPanel.Dock="Top" IsVisible="{Binding Shell.IsBarVisible}" Classes.player="{Binding Config.Preferences.UiMode, Converter={StaticResource EnumMatchConverter}, ConverterParameter={x:Static lg:UiMode.Player}}" />

		<!--macOS, bar hidden: the strip the native game view does not cover, so
		the window stays draggable (ShellTitleBar.DragStripHeight).-->
		<Border Name="ShellDragStrip" DockPanel.Dock="Top" Background="Black" IsVisible="False" />

		<!--G.6 (W-X3): the inline question before work is lost, above any profile.-->
		<Panel Name="InterruptionBarHost" DockPanel.Dock="Top" IsVisible="{Binding Interruption.IsVisible}" Classes.player="{Binding Config.Preferences.UiMode, Converter={StaticResource EnumMatchConverter}, ConverterParameter={x:Static lg:UiMode.Player}}">
			<v:InterruptionBar Name="InterruptionBar" DataContext="{Binding Interruption}" />
		</Panel>

		<!--G.3 (W-R2): Remaster's recording strip - one pill and Stop - above the
		game, which fills the rest of the window inside Remaster.-->
		<Panel Name="RemasterRecordingStripHost" DockPanel.Dock="Top" IsVisible="{Binding IsRemasterGameView}" Classes="remaster" Classes.player="{Binding Config.Preferences.UiMode, Converter={StaticResource EnumMatchConverter}, ConverterParameter={x:Static lg:UiMode.Player}}">
			<v:RemasterRecordingStrip Name="RemasterRecordingStrip" DataContext="{Binding Remaster}" />
		</Panel>

		<!--ADR-0249 (W-R2): the recording hint's toast under the game (Player only; empty in Advanced).-->
		<Panel Name="RemasterRecordingHintHost" DockPanel.Dock="Bottom" IsVisible="{Binding IsRemasterGameView}" Classes="remaster" Classes.player="{Binding Config.Preferences.UiMode, Converter={StaticResource EnumMatchConverter}, ConverterParameter={x:Static lg:UiMode.Player}}">
			<v:RemasterRecordingHint Name="RemasterRecordingHint" DataContext="{Binding Remaster}" />
		</Panel>

		<!--G.8 (W-H4): the replay pill and Stop above the game, inside Share.-->
		<Panel Name="ShareRecordingStripHost" DockPanel.Dock="Top" IsVisible="{Binding IsShareGameView}">
			<v:ShareRecordingStrip Name="ShareRecordingStrip" DataContext="{Binding Share}" Classes="share" Classes.player="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Config.Preferences.UiMode, Converter={StaticResource EnumMatchConverter}, ConverterParameter={x:Static lg:UiMode.Player}}" />
		</Panel>

		<!--G.1 (W-S1): the one-sentence, read-only status line; shown and hidden
		with the bar.-->
		<Border Name="ShellStatusLine" DockPanel.Dock="Bottom" Height="26" Padding="12 0" IsVisible="{Binding Shell.IsBarVisible}" Classes.player="{Binding Config.Preferences.UiMode, Converter={StaticResource EnumMatchConverter}, ConverterParameter={x:Static lg:UiMode.Player}}">
			<StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
				<TextBlock Name="ShellStatusDot" Text="●" FontSize="10" Opacity="0.5" VerticalAlignment="Center" Classes.live="{Binding Shell.HasGame}" />
				<TextBlock Name="ShellStatusText" Text="{Binding Shell.StatusText}" VerticalAlignment="Center" />
			</StackPanel>
		</Border>

		<ContentControl Name="AudioPlayer" DockPanel.Dock="Bottom" Content="{Binding AudioPlayer}" IsVisible="{Binding IsPlayWorkspace}" />

		<Panel Name="RendererPanel" Background="Black" Focusable="True">
			<!--G.3: the game picture is its own layer, shown in Play and in
			Remaster's recording view (IsGameViewVisible); Play's own surfaces
			stay in PlayWorkspace above it.-->
			<Canvas IsVisible="{Binding IsGameViewVisible}">
				<ContentControl
					Name="RendererContainer"
					UseLayoutRounding="False"
				/>
			</Canvas>

			<Panel IsVisible="{Binding IsSoftwareRendererVisible}">
				<c:SoftwareRendererView
					Name="SoftwareRenderer"
					DataContext="{Binding SoftwareRenderer}"
					Width="{Binding Width}"
					Height="{Binding Height}"
			  />
			</Panel>

			<!--G.1: every Play surface lives in PlayWorkspace. Outside Play it is
			hidden as a whole (never closed or reset), so nothing of Play is on
			screen under Remaster/Share and switching back shows it as it was.
			The native renderer is hidden with it (UpdateRendererVisibility).-->
			<!--ADR-0249: in Player mode PlayWorkspace is the theme's scope (`player`,
			Play's tint); Advanced keeps the classic look.-->
			<Panel Name="PlayWorkspace" IsVisible="{Binding IsPlayWorkspace}" Classes.player="{Binding Config.Preferences.UiMode, Converter={StaticResource EnumMatchConverter}, ConverterParameter={x:Static lg:UiMode.Player}}">
				<ContentControl Background="#181818" Content="{Binding RecentGames}" IsVisible="{Binding RecentGames.Visible}" />

				<!--"Sim, quadro congelado" (2026-10-03): the native picture is hidden
				under W-P4 and its sheets (PlayGameLayer), so the frame the game
				stopped on stands in for it, blurred like W-P4's render, in the live
				picture's box (SoftwareRenderer.Width/Height, centred and unrounded
				like the native renderer) so nothing jumps.-->
				<Image
					Name="PausedGameFrame"
					Source="{Binding PausedGameFrame}"
					IsVisible="{Binding IsPausedGameFrameVisible}"
					Width="{Binding SoftwareRenderer.Width}"
					Height="{Binding SoftwareRenderer.Height}"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Stretch="Fill"
					UseLayoutRounding="False"
					IsHitTestVisible="False"
				>
					<Image.Effect>
						<BlurEffect Radius="12" />
					</Image.Effect>
				</Image>
				<!--W-P9 (#734): a pack installing while the game plays. A popup is its
				own window, so on macOS it floats above the native game picture,
				which stays shown; the bar fills with the download when its size is
				known and moves indeterminately otherwise. Never takes a click or
				the keyboard.-->
				<Popup Name="PackInstallPillPopup" IsOpen="{Binding IsPackInstallPillShown}" IsLightDismissEnabled="False" WindowManagerAddShadowHint="False" ShouldUseOverlayLayer="False" TakesFocusFromNativeControl="False"
					Placement="AnchorAndGravity" PlacementAnchor="TopRight" PlacementGravity="BottomLeft" HorizontalOffset="-4" VerticalOffset="4">
					<Border Name="PackInstallPill" Classes="hud" Classes.compact="{Binding IsPackInstallPillFailed}" Padding="16 14" Margin="12 12 12 20" MaxWidth="440" IsHitTestVisible="False">
						<DockPanel>
							<Border Classes="badge medium" DockPanel.Dock="Left" Margin="0 0 14 0" Background="{StaticResource PlayerTintShareBrush}" IsVisible="{Binding IsPackInstallPillInstalling}"><PathIcon Data="{StaticResource PlayerIconPack}" /></Border>
							<PathIcon DockPanel.Dock="Left" Data="{StaticResource PlayerIconWarning}" Foreground="{StaticResource PlayerOrangeBrush}" IsVisible="{Binding IsPackInstallPillFailed}" />
							<StackPanel VerticalAlignment="Center" Spacing="9">
								<TextBlock Name="PackInstallPillText" Classes="headline" Text="{Binding PackInstallPillText}" TextTrimming="CharacterEllipsis" />
								<ProgressBar Name="PackInstallPillBar" Width="300" Minimum="0" Maximum="100" IsVisible="{Binding IsPackInstallPillInstalling}" IsIndeterminate="{Binding IsPackInstallPillIndeterminate}" Value="{Binding PackInstallPillPercent}" />
							</StackPanel>
						</DockPanel>
					</Border>
				</Popup>

				<!--W-P4: the game stays behind the overlay, dimmed.-->
				<Border Name="PlayerOverlayScrim" Classes="scrim">
					<Border.IsVisible>
						<MultiBinding Converter="{x:Static BoolConverters.Or}">
							<Binding Path="IsPlayerOverlayVisible" />
							<Binding Path="IsSaveStatesSheetVisible" />
							<!--ADR-0249: the light sheets W-P5 … W-P11 dim the game too.-->
							<Binding Path="IsEnhancementsPanelVisible" />
							<Binding Path="IsPlayerPackPickerVisible" />
							<Binding Path="IsPackDetailVisible" />
							<Binding Path="CheatsSheet.IsVisible" />
							<Binding Path="ReplaysSheet.IsVisible" />
							<Binding Path="IsPlayerSettingsVisible" />
						</MultiBinding>
					</Border.IsVisible>
				</Border>

				<!--G.2 (PRD Part B §13.5.2 W-P4, replacing P.4's overlay): the pause
				overlay. Seven controls (rule 2, UI/Logic/PauseOverlay): Resume, Save
				states, Pack, Enhancements, Cheats, Settings, Quit game. Advanced GUI
				and quitting the app moved to Tools ⋯ in the bar the overlay reveals.
				D-pad/A/B and arrows move through the rows (XY focus); Resume has
				focus on open. Esc resumes (rule 8).-->
				<Border
					Name="PlayerOverlay"
					Classes="overlay-card"
					Width="380"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Margin="0 12"
					Padding="16 22 16 18"
					IsVisible="{Binding IsPauseCardVisible}"
					IsHitTestVisible="{Binding !IsPauseCardDimmed}"
				>
					<!--W-P4's card is ~520 tall; a shorter window scrolls it, so
					every control stays reachable by arrow keys (focus brings it
					into view). The card's side padding moves inside the scroller (Margin
					8) so the grouped list's -8 outset is not clipped.-->
					<ScrollViewer VerticalScrollBarVisibility="Hidden">
					<StackPanel Name="OverlayControls" Margin="8 0" XYFocus.NavigationModes="Enabled">
						<TextBlock Name="OverlayGameTitle" Classes="title2" Text="{Binding OverlayGameTitle}" TextTrimming="CharacterEllipsis" />
						<TextBlock Classes="secondary" Text="{l:Translate lblOverlayPaused}" Margin="0 4 0 16" />
						<!--W-P4: a drawn play icon leads the label (no ▶ glyph in the string).-->
						<Button Name="OverlayResumeButton" Classes="primary large" HorizontalAlignment="Stretch" Click="OnOverlayResume" Margin="0 0 0 20">
							<StackPanel Orientation="Horizontal">
								<PathIcon Classes="leading" Data="{StaticResource PlayerIconPlay}" />
								<TextBlock Text="{l:Translate btnOverlayResume}" />
							</StackPanel>
						</Button>
						<Border Classes="group" Margin="-8 0">
							<StackPanel>
								<Button Name="OverlaySaveStatesButton" Classes="row" Click="OnOverlaySaveStates">
									<DockPanel>
										<Border Classes="badge" Background="{StaticResource PlayerIndigoBrush}"><PathIcon Data="{StaticResource PlayerIconSaveStates}" /></Border>
										<PathIcon Classes="chevron" DockPanel.Dock="Right" />
										<TextBlock Classes="value" DockPanel.Dock="Right" Name="OverlaySaveStatesValue" Text="{Binding SaveStatesRowValue}" />
										<TextBlock Classes="title" Text="{l:Translate btnOverlaySaveStates}" />
									</DockPanel>
								</Button>
								<!--P.5 (§5): opens the picker (2+ packs, W-P5) or the pack window.-->
								<Button Name="OverlayPackButton" Classes="row" Click="OnOverlayPack">
									<DockPanel>
										<Border Classes="badge" Background="{StaticResource PlayerTintShareBrush}"><PathIcon Data="{StaticResource PlayerIconPack}" /></Border>
										<PathIcon Classes="chevron" DockPanel.Dock="Right" />
										<TextBlock Classes="value" DockPanel.Dock="Right" Name="OverlayPackValue" Text="{Binding PackSummary}" />
										<TextBlock Classes="title" Text="{l:Translate btnOverlayPack}" />
									</DockPanel>
								</Button>
								<!--P.7 (§6.1): the quick-toggle panel.-->
								<Button Name="OverlayEnhancementsButton" Classes="row" Click="OnOverlayEnhancements">
									<DockPanel>
										<Border Classes="badge" Background="{StaticResource PlayerOrangeBrush}"><PathIcon Data="{StaticResource PlayerIconEnhancements}" /></Border>
										<PathIcon Classes="chevron" DockPanel.Dock="Right" />
										<TextBlock Classes="value" DockPanel.Dock="Right" Name="OverlayEnhancementsValue" Text="{Binding EnhancementsSummary}" />
										<TextBlock Classes="title" Text="{l:Translate btnOverlayEnhancements}" />
									</DockPanel>
								</Button>
								<!--P.10 (W-P4 › W-P11, ADR-0245 §1): Cheats · N on.-->
								<Button Name="OverlayCheatsButton" Classes="row" Click="OnOverlayCheats">
									<DockPanel>
										<Border Classes="badge" Background="{StaticResource PlayerPinkBrush}"><PathIcon Data="{StaticResource PlayerIconCheats}" /></Border>
										<PathIcon Classes="chevron" DockPanel.Dock="Right" />
										<TextBlock Classes="value" DockPanel.Dock="Right" Name="OverlayCheatsSummary" Text="{Binding CheatsSummary}" />
										<TextBlock Classes="title" Text="{l:Translate btnOverlayCheats}" />
									</DockPanel>
								</Button>
								<Button Name="OverlaySettingsButton" Classes="row" Click="OnOverlaySettings">
									<DockPanel>
										<Border Classes="badge" Background="{StaticResource PlayerGrayBrush}"><PathIcon Data="{StaticResource PlayerIconSettings}" /></Border>
										<PathIcon Classes="chevron" DockPanel.Dock="Right" />
										<TextBlock Classes="title" Text="{l:Translate btnOverlaySettings}" />
									</DockPanel>
								</Button>
							</StackPanel>
						</Border>
						<!--W-P4: powers the game off and lands on the Play home; it no
						longer closes the app (Tools ⋯ › File › Exit, ⌘Q / Alt+F4).-->
						<Button Name="OverlayQuitGameButton" Classes="destructive medium" HorizontalAlignment="Stretch" Click="OnOverlayQuitGame" Margin="0 38 0 0" IsVisible="{Binding !QuitGameConfirm.IsVisible}">
							<TextBlock Text="{l:Translate btnOverlayQuitGame}" />
						</Button>
						<!--ADR-0249 (W-X1): ConfirmExitResetPower asks here, in place of the button.-->
						<v:OverlayConfirmBanner Name="QuitGameConfirm" DataContext="{Binding QuitGameConfirm}" IsVisible="{Binding IsVisible}" Margin="0 38 0 0" />
						<!--TEXT2, not the render's TEXT3: TEXT3 on the card is 2.5:1, under
						PlaySheetsContrastTests' 4.5:1.-->
						<TextBlock Classes="footnote secondary" Text="{l:Translate lblOverlayEscHint}" HorizontalAlignment="Center" Margin="0 26 0 0" />
					</StackPanel>
					</ScrollViewer>
				</Border>

				<!--"Seguir o render" (2026-10-03): a sheet opened from W-P4 leaves the
				card on screen behind it, under one more dim layer (W-P5 … W-P16).-->
				<Border Name="PlayerSheetScrim" Background="{StaticResource PlayerSheetOverCardScrimBrush}" IsVisible="{Binding IsPauseCardDimmed}" />

				<!--G.2 (W-P4 Save states row): Save and Load merged into one row; this
				sheet opens today's slot grid in either mode. Esc (or Back) returns
				to the overlay.-->
				<Border
					Name="PlayerSaveStatesSheet"
					Classes="sheet"
					Width="340"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					IsVisible="{Binding IsSaveStatesSheetVisible}"
				>
					<StackPanel Spacing="10" XYFocus.NavigationModes="Enabled">
						<TextBlock Classes="title3" Text="{l:Translate lblSaveStatesSheetTitle}" />
						<TextBlock Classes="secondary" Text="{Binding SaveStatesRowValue}" Margin="0 0 0 6" />
						<Button Name="SaveStatesSaveButton" Classes="primary medium" Content="{l:Translate btnSaveStatesSave}" HorizontalAlignment="Stretch" Click="OnSaveStatesSave" />
						<Button Name="SaveStatesLoadButton" Classes="secondary medium" Content="{l:Translate btnSaveStatesLoad}" HorizontalAlignment="Stretch" Click="OnSaveStatesLoad" />
						<!--R.2 (ADR-0205 §7): W-P4 is at its seven controls, so the shared
						replays for this copy open from here.-->
						<Button Name="SaveStatesReplaysButton" Classes="secondary medium" Content="{l:Translate btnSaveStatesReplays}" HorizontalAlignment="Stretch" Click="OnSaveStatesReplays" />
						<Button Name="SaveStatesBackButton" Classes="plain medium" Content="{l:Translate btnSaveStatesBack}" HorizontalAlignment="Stretch" Click="OnSaveStatesBack" />
					</StackPanel>
				</Border>

				<!--#716 / ADR-0249: the sheets the overlay opens are light sheets
				(Border.sheet, W-P5 … W-P11) with their own text colour, so they need
				no Dark theme scope any more. PlaySheetsContrastTests checks every
				text's contrast under both app themes.-->
				<!--G.4 (W-P7, was P.7 §6.1): the Enhancements sheet.-->
				<v:PlayerEnhancementsSheetView Name="PlayerEnhancementsSheetHost" IsVisible="{Binding IsEnhancementsPanelVisible}" />

				<!--P.10 (PRD Part B §13 W-P11): the Cheats sheet.-->
				<v:PlayerCheatsSheetView Name="PlayerCheatsSheetHost" DataContext="{Binding CheatsSheet}" IsVisible="{Binding IsVisible}" />

				<!--R.2 (ADR-0205 §7): Save states › Shared replays.-->
				<v:PlayerReplaysSheetView Name="PlayerReplaysSheetHost" DataContext="{Binding ReplaysSheet}" IsVisible="{Binding IsVisible}" />

				<!--G.4 (W-P5, was P.5 §5): the pack picker; (W-P6) the current pack detail.-->
				<v:PlayerPackPickerSheetView Name="PlayerPackPickerHost" IsVisible="{Binding IsPlayerPackPickerVisible}" />
				<v:PlayerPackDetailSheetView Name="PlayerPackDetailHost" IsVisible="{Binding IsPackDetailVisible}" />

				<!--G.5 (PRD Part B §13.5.2 W-P13, W-P15, W-P16): the Play edge-flow sheets.-->
				<v:PlayPackDepSheetView Name="PlayPackDepSheetHost" DataContext="{Binding PackDepSheet}" IsVisible="{Binding IsVisible}" />
				<v:PlayControllerSetupView Name="PlayControllerSetupHost" DataContext="{Binding ControllerSetup}" />
			</Panel>

			<!--G.3 (PRD Part B §13.5.3): Remaster's project screens (W-R0, W-R0b,
			W-R1, the W-R3 card); the game keeps running behind them.-->
			<Panel Name="RemasterWorkspaceHost" IsVisible="{Binding IsRemasterProjectScreenVisible}" Classes="remaster" Classes.player="{Binding Config.Preferences.UiMode, Converter={StaticResource EnumMatchConverter}, ConverterParameter={x:Static lg:UiMode.Player}}">
				<v:RemasterWorkspaceView Name="RemasterWorkspace" DataContext="{Binding Remaster}" />
			</Panel>

			<!--G.8 (PRD Part B §13.5.4): Share's screens (W-H1-W-H3, W-H4's
			sheets); the game keeps running behind them. ADR-0249: the view
			itself carries the Player scope (its classic styles key off
			`:not(.player)`); its DataContext is Share, hence the cast.-->
			<Panel Name="ShareWorkspaceHost" IsVisible="{Binding IsShareScreenVisible}">
				<v:ShareWorkspaceView Name="ShareWorkspace" DataContext="{Binding Share}" Classes="share" Classes.player="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Config.Preferences.UiMode, Converter={StaticResource EnumMatchConverter}, ConverterParameter={x:Static lg:UiMode.Player}}" />
			</Panel>

			<!--ADR-0249 (W-P8, W-P10): W-P4's Settings, a sheet in this window.
			ADR-0250: also every task door's Settings… (Tools ⋯ or the macOS app
			menu), so it sits above the workspaces with its own Player scope.-->
			<Panel Name="PlayerSettingsLayer" IsVisible="{Binding IsPlayerSettingsVisible}" Classes.player="{Binding Config.Preferences.UiMode, Converter={StaticResource EnumMatchConverter}, ConverterParameter={x:Static lg:UiMode.Player}}">
				<Panel IsEnabled="{Binding !IsShaderSheetVisible}">
					<v:PlayerSettingsSheetView Name="PlayerSettingsSheetHost" DataContext="{Binding PlayerSettings}" />
				</Panel>
				<!--ADR-0249 (W-P10 › Adjust…): the shader's parameters, over Settings.-->
				<v:PlayerShaderSheetView Name="PlayerShaderSheetHost" IsVisible="{Binding IsShaderSheetVisible}" />
			</Panel>

			<!--#734: the load card's layer sits above every workspace: an open
			shows it in Play, a reload wherever the game is on screen (Play,
			Remaster's and Share's game views), in that workspace's tint.-->
			<Panel Name="LoadWaitHost" Classes.player="{Binding Config.Preferences.UiMode, Converter={StaticResource EnumMatchConverter}, ConverterParameter={x:Static lg:UiMode.Player}}" Classes.remaster="{Binding IsRemasterGameView}" Classes.share="{Binding IsShareGameView}">
				<!--#734: the load card (W-P9's HUD pill shape), from an open or a
				reload to the game's first picture (Logic/PlayLoadWait). It is a
				surface over the game (PlayGameLayer): the native picture is hidden
				while it shows, so it cannot cover the card. The scrim takes the
				clicks, so a second open does not queue behind this one; the BIOS
				sheet asks over it.-->
				<Panel Name="PlayLoadWaitLayer" Classes="scrim">
					<Panel.IsVisible>
						<MultiBinding Converter="{x:Static BoolConverters.And}">
							<Binding Path="IsLoadWaitActive" />
							<Binding Path="!BiosSheet.IsVisible" />
						</MultiBinding>
					</Panel.IsVisible>
					<Border Name="PlayLoadWaitCard" Classes="hud" Width="340" Padding="16 14" HorizontalAlignment="Center" VerticalAlignment="Center">
						<DockPanel>
							<Border Classes="badge medium" DockPanel.Dock="Left" Margin="0 0 14 0"><PathIcon Data="{StaticResource PlayerIconPlay}" /></Border>
							<StackPanel VerticalAlignment="Center" Spacing="9">
								<TextBlock Name="PlayLoadWaitText" Classes="headline" Text="{Binding LoadWaitText}" TextTrimming="CharacterEllipsis" />
								<!--Indeterminate: neither the Core's load nor the first
								frames report a percentage.-->
								<ProgressBar Name="PlayLoadWaitBar" IsIndeterminate="True" />
							</StackPanel>
						</DockPanel>
					</Border>
				</Panel>
			</Panel>

			<!--G.5 (W-P13), ADR-0249: the BIOS sheet asks in whichever workspace
			started the load (Play, or Remaster/Share opening a disk game), so it
			sits above every workspace with its own Player scope (Play's tint).-->
			<Panel Name="BiosSheetLayer" Classes.player="{Binding Config.Preferences.UiMode, Converter={StaticResource EnumMatchConverter}, ConverterParameter={x:Static lg:UiMode.Player}}">
				<v:PlayBiosSheetView Name="PlayBiosSheetHost" DataContext="{Binding BiosSheet}" IsVisible="{Binding IsVisible}" />
				<!--ADR-0249 (W-P5 sheet shape): an archive's games, from any workspace's open.-->
				<v:PlaySelectRomSheetView Name="PlaySelectRomSheetHost" DataContext="{Binding SelectRomSheet}" IsVisible="{Binding IsVisible}" />
				<!--ADR-0250 Decision 3: a task door's About, Help › Command Line and
				Check for Updates, Record › Video and Insert Barcode, from any door,
				in that door's tint.-->
				<v:PlayerToolSheetView Name="PlayerToolSheetHost" DataContext="{Binding ToolSheet}" IsVisible="{Binding IsVisible}"
					Classes.remaster="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Shell.Active, Converter={StaticResource EnumMatchConverter}, ConverterParameter={x:Static lg:Workspace.Remaster}}"
					Classes.share="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Shell.Active, Converter={StaticResource EnumMatchConverter}, ConverterParameter={x:Static lg:Workspace.Share}}" />
			</Panel>
		</Panel>
	</DockPanel>
</Window>
