<Window
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:vm="using:Mesen.ViewModels"
	xmlns:l="using:Mesen.Localization"
	xmlns:lg="using:Mesen.Logic"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d"
	x:Class="Mesen.Windows.SetupWizardWindow"
	Width="520"
	SizeToContent="Height"
	CanResize="False"
	WindowStartupLocation="CenterScreen"
	x:DataType="vm:SetupWizardViewModel"
	Title="{l:Translate wndTitle}"
	Name="root"
>
	<Window.Styles>
		<!-- The render's 13.5 px semibold question and its 13.5 px regular intro. -->
		<Style Selector=".player TextBlock.callout.strong">
			<Setter Property="FontWeight" Value="SemiBold" />
		</Style>
		<Style Selector=".player TextBlock.callout.regular">
			<Setter Property="FontWeight" Value="Normal" />
		</Style>
		<!-- A choice's secondary line, under the label past the radio circle. -->
		<Style Selector="TextBlock.first-run-detail">
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="Margin" Value="28 2 0 0" />
			<Setter Property="Opacity" Value="0.6" />
		</Style>
		<Style Selector=".player TextBlock.first-run-detail">
			<Setter Property="Opacity" Value="1" />
			<Setter Property="FontSize" Value="{StaticResource PlayerFontSubhead}" />
			<Setter Property="Foreground" Value="{StaticResource PlayerText2Brush}" />
		</Style>
	</Window.Styles>

	<Design.DataContext>
		<vm:SetupWizardViewModel />
	</Design.DataContext>

	<!--G.5 (PRD Part B §13.5.2 W-P12): the first-run sheet. Rule 2: two radios,
	the keyboard popup and Start Playing = 4 (6 with the Windows/Linux
	checkboxes). Esc and the close button keep the choice and continue.
	ADR-0249: the wizard runs in its own process before a config or the core
	exist (Program.cs restarts afterwards), so it cannot be a sheet over the
	main window; the window itself is drawn as the render's card.-->
	<Border Name="FirstRunCard" Classes="player" Background="{StaticResource PlayerCardBrush}" Padding="24 22 24 22">
		<StackPanel XYFocus.NavigationModes="Enabled">
			<StackPanel Orientation="Horizontal" Spacing="14">
				<Border Name="FirstRunBadge" Classes="badge xl" Background="{StaticResource PlayerTintPlayBrush}">
					<PathIcon Data="{StaticResource PlayerIconPlay}" />
				</Border>
				<TextBlock Name="FirstRunTitle" Classes="title2" Text="{l:Translate lblFirstRunTitle}" VerticalAlignment="Center" />
			</StackPanel>
			<TextBlock Classes="callout regular" Text="{l:Translate lblFirstRunIntro}" TextWrapping="Wrap" Margin="0 18 0 0" />

			<TextBlock Name="FirstRunStorageTitle" Classes="callout strong" Text="{l:Translate lblFirstRunStorage}" Margin="0 22 0 6" />
			<StackPanel Margin="2 0 0 0">
				<RadioButton Name="FirstRunUserFolder" Classes="choice" GroupName="FirstRunStorage" Content="{l:Translate radFirstRunUserFolder}" IsChecked="{Binding StoreInUserProfile}" />
				<TextBlock Classes="first-run-detail" Text="{Binding UserFolder}" />
				<RadioButton Name="FirstRunPortable" Classes="choice" GroupName="FirstRunStorage" Content="{l:Translate radFirstRunPortable}" IsChecked="{Binding !StoreInUserProfile}" Margin="0 10 0 0" />
				<TextBlock Classes="first-run-detail" Text="{l:Translate lblFirstRunPortableHint}" />
			</StackPanel>

			<Separator Classes="hairline" Margin="0 16 0 14" />

			<StackPanel Orientation="Horizontal">
				<TextBlock Classes="callout strong" Text="{l:Translate lblFirstRunKeyboard}" VerticalAlignment="Center" Width="126" />
				<ComboBox Name="FirstRunKeyboard" Classes="popup" Width="220" SelectedIndex="{Binding KeyboardIndex}">
					<ComboBoxItem Content="{l:Translate cboFirstRunArrows}" />
					<ComboBoxItem Content="{l:Translate cboFirstRunWasd}" />
				</ComboBox>
			</StackPanel>
			<TextBlock Classes="subhead secondary" Text="{l:Translate lblFirstRunGamepads}" TextWrapping="Wrap" Margin="0 12 0 0" />

			<StackPanel Name="FirstRunDesktopOptions" Spacing="2" Margin="0 12 0 0" IsVisible="{Binding ShowsDesktopOptions}">
				<CheckBox
					Name="FirstRunCheckForUpdates"
					Content="{l:Translate chkFirstRunCheckForUpdates}"
					IsChecked="{Binding CheckForUpdates}"
					IsEnabled="{x:Static lg:UpdateChannel.HasFeed}"
					ToolTip.Tip="{l:Translate lblUpdateCheckUnavailable}"
					ToolTip.ShowOnDisabled="True"
				/>
				<CheckBox Content="{l:Translate chkFirstRunDesktopShortcut}" IsChecked="{Binding CreateShortcut}" />
			</StackPanel>

			<TextBlock Name="FirstRunError" Classes="reason" Text="{Binding ErrorText}" IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" Margin="0 12 0 0" />

			<Button
				Name="FirstRunStartPlaying"
				Classes="primary medium"
				HorizontalAlignment="Right"
				Click="BtnStart_OnClick"
				Margin="0 22 0 0"
			>
				<StackPanel Orientation="Horizontal" Spacing="8">
					<PathIcon Data="{StaticResource PlayerIconPlay}" Width="12" Height="12" />
					<TextBlock Text="{l:Translate btnFirstRunStartPlaying}" />
				</StackPanel>
			</Button>
		</StackPanel>
	</Border>
</Window>
