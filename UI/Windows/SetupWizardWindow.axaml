<Window
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:vm="using:Mesen.ViewModels"
	xmlns:l="using:Mesen.Localization"
	xmlns:lg="using:Mesen.Logic"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d"
	x:Class="Mesen.Windows.SetupWizardWindow"
	Width="520"
	SizeToContent="Height"
	CanResize="False"
	WindowStartupLocation="CenterScreen"
	x:DataType="vm:SetupWizardViewModel"
	Title="{l:Translate wndTitle}"
	Name="root"
>
	<Design.DataContext>
		<vm:SetupWizardViewModel />
	</Design.DataContext>

	<!--G.5 (PRD Part B §13.5.2 W-P12): the first-run sheet. Rule 2: two radios,
	the keyboard popup and Start Playing = 4 (6 with the Windows/Linux
	checkboxes). Esc and the close button keep the choice and continue.-->
	<StackPanel Margin="28 24" Spacing="10" XYFocus.NavigationModes="Enabled">
		<StackPanel Orientation="Horizontal" Spacing="12">
			<Border Width="40" Height="40" CornerRadius="8" Background="#0A84FF">
				<TextBlock Text="▶" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
			</Border>
			<TextBlock Text="{l:Translate lblFirstRunTitle}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
		</StackPanel>
		<TextBlock Text="{l:Translate lblFirstRunIntro}" TextWrapping="Wrap" />

		<TextBlock Text="{l:Translate lblFirstRunStorage}" FontWeight="Bold" Margin="0 8 0 0" />
		<StackPanel Spacing="2">
			<RadioButton Name="FirstRunUserFolder" GroupName="FirstRunStorage" Content="{l:Translate radFirstRunUserFolder}" IsChecked="{Binding StoreInUserProfile}" />
			<TextBlock Text="{Binding UserFolder}" Opacity="0.6" Margin="28 0 0 4" TextWrapping="Wrap" />
			<RadioButton Name="FirstRunPortable" GroupName="FirstRunStorage" Content="{l:Translate radFirstRunPortable}" IsChecked="{Binding !StoreInUserProfile}" />
			<TextBlock Text="{l:Translate lblFirstRunPortableHint}" Opacity="0.6" Margin="28 0 0 0" TextWrapping="Wrap" />
		</StackPanel>

		<Separator Margin="0 6" />

		<DockPanel>
			<TextBlock Text="{l:Translate lblFirstRunKeyboard}" FontWeight="Bold" VerticalAlignment="Center" Width="110" />
			<ComboBox Name="FirstRunKeyboard" SelectedIndex="{Binding KeyboardIndex}" HorizontalAlignment="Stretch">
				<ComboBoxItem Content="{l:Translate cboFirstRunArrows}" />
				<ComboBoxItem Content="{l:Translate cboFirstRunWasd}" />
			</ComboBox>
		</DockPanel>
		<TextBlock Text="{l:Translate lblFirstRunGamepads}" Opacity="0.7" TextWrapping="Wrap" />

		<StackPanel Name="FirstRunDesktopOptions" Spacing="2" IsVisible="{Binding ShowsDesktopOptions}">
			<CheckBox
				Name="FirstRunCheckForUpdates"
				Content="{l:Translate chkFirstRunCheckForUpdates}"
				IsChecked="{Binding CheckForUpdates}"
				IsEnabled="{x:Static lg:UpdateChannel.HasFeed}"
				ToolTip.Tip="{l:Translate lblUpdateCheckUnavailable}"
				ToolTip.ShowOnDisabled="True"
			/>
			<CheckBox Content="{l:Translate chkFirstRunDesktopShortcut}" IsChecked="{Binding CreateShortcut}" />
		</StackPanel>

		<TextBlock Name="FirstRunError" Text="{Binding ErrorText}" IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Foreground="#B25000" TextWrapping="Wrap" />

		<Button
			Name="FirstRunStartPlaying"
			HorizontalAlignment="Right"
			Padding="18 8"
			FontWeight="Bold"
			Background="#0A84FF"
			Foreground="White"
			Click="BtnStart_OnClick"
			Content="{l:Translate btnFirstRunStartPlaying}"
			Margin="0 8 0 0"
		/>
	</StackPanel>
</Window>
